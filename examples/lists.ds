// The list surface: literals build lists element by element, the
// `list[t]()` constructor spellings the empty form, and the checked read
// extracts through the `.ok`/`.err` handler chain. `len` is the ambient
// generic — the same call over string and list receivers.

fn main() -> () {
  const xs = [1, 2, 3]
  const words = ["alpha", "beta", "gamma"]
  const empty = list[int]()
  println("ints ${walk_total(xs)} ${len(empty)}")
  println("words ${len(words)} ${head_word(words)}")
}

fn walk_total(xs: list[int]) -> int {
  var total: int = 0
  var i: int = 0
  while i < len(xs) {
    const cell = xs.get(i)
    total += cell.ok((x: int) => x).err((_: none) => 0)
    i += 1
  }
  total
}

fn head_word(xs: list[string]) -> string {
  const cell = xs.get(0)
  cell.ok((w: string) => w).err((_: none) => "?")
}
