// The tutorial's concurrency block realized over the ambient's full
// net_err taxonomy: `fetch_all` fans the
// fetches out over `spawn` inside a `nursery`, each child's answer
// riding the join channel (the block's value is the collected answers
// in spawn order), the first failure cancels the in-flight sibling at
// its next backward branch, and the child error unions out at the
// boundary into the caller's match. The deterministic fetch_body stands in for
// the net capability: the unreachable host refuses, the slow one times
// out, everything else answers a body.

fn fetch_body(u: string) -> string | net_err {
  if u == "https://down.example" {
    refused
  } else {
    if u == "https://slow.example" {
      net_err::timeout
    } else {
      "body of ${u}"
    }
  }
}

fn fetch_all(urls: list[string]) -> int | net_err {
  const bodies = nursery {
    for u in urls {
      spawn {
        match fetch_body(u) {
          timeout => cancel(net_err::timeout)
          refused => cancel(net_err::refused)
          addr_in_use => cancel(net_err::addr_in_use)
          reset => cancel(net_err::reset)
          net_other { msg } => cancel(net_err::net_other(msg: msg))
          body => body
        }
      }
    }
  }
  const kept = bodies.len()
  kept
}

fn main() -> () {
  const good = ["https://ds.dev", "https://example.org"]
  match fetch_all(good) {
    timeout => println("caught timeout")
    refused => println("caught refused")
    addr_in_use => println("caught addr in use")
    reset => println("caught reset")
    net_other { msg } => println("caught other")
    n => println("kept ${n} bodies")
  }
  const bad = ["https://down.example", "https://slow.example"]
  match fetch_all(bad) {
    timeout => println("caught timeout")
    refused => println("caught refused")
    addr_in_use => println("caught addr in use")
    reset => println("caught reset")
    net_other { msg } => println("caught other")
    n => println("kept ${n} bodies")
  }
}
