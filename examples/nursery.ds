// The tutorial's concurrency block, end to end: `fetch_all` fans the
// fetches out over `spawn` inside a `nursery`, scope exit joins in
// spawn order, the first failure cancels the in-flight sibling at its
// next backward branch, and the child error unions out at the boundary
// into the caller's match. The deterministic fetch_body stands in for
// the net capability: the unreachable host refuses, the slow one times
// out, everything else answers a body.

fn fetch_body(u: string) -> string | net_err {
  if u == "https://down.example" {
    refused
  } else {
    if u == "https://slow.example" {
      timeout
    } else {
      "body of ${u}"
    }
  }
}

fn fetch_all(urls: list[string]) -> int | net_err {
  var bodies = list[string]()
  nursery {
    for u in urls {
      spawn {
        match fetch_body(u) {
          timeout => cancel(timeout)
          refused => cancel(refused)
          body => bodies.push(body)
        }
      }
    }
  }
  const kept = len(bodies)
  kept
}

fn main() -> () {
  const good = ["https://ds.dev", "https://example.org"]
  match fetch_all(good) {
    timeout => println("caught timeout")
    refused => println("caught refused")
    n => println("kept ${n} bodies")
  }
  const bad = ["https://down.example", "https://slow.example"]
  match fetch_all(bad) {
    timeout => println("caught timeout")
    refused => println("caught refused")
    n => println("kept ${n} bodies")
  }
}
