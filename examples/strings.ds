// The scalar-to-string conversions through the interpolation boundary:
// printable primitives convert implicitly, strings pass through.

fn main() -> () {
  const name = "DreamScript"
  const count = 42
  const ratio = 2.5
  const ok = true
  println("int: ${count}")
  println("float: ${ratio}")
  println("bool: ${ok}")
  println("greeting: hello, ${name}")
}
