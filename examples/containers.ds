// The container closes over CALLG dispatch: cons prepends an element,
// tail drops the first, collect copies, first answers the checked
// first element (the empty list the none member), and the ordering
// pair answers over its @std int members (the float and generic
// spellings riding the later linked-surface rounds).

fn first_int(xs: list[int]) -> int {
  const cell = xs.first()
  cell.ok((x: int) => x).err((_: none) => -1)
}

fn main() -> () {
  const ints = list[int]().cons(2).cons(1)
  const rest = ints.tail()
  println("cons ${ints.len()} ${first_int(ints)} ${rest.len()} ${first_int(rest)}")
  const blank = list[int]().collect()
  const blank_first = blank.first()
  println("empty ${first_int(blank)} ${blank_first.ok((x: int) => x).err((_: none) => -1)}")
  println("max ${(3).max(9)} ${(3).min(9)}")
}
