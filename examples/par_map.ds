// E3's fork-join combinator, end to end on one thread: par_map forks
// one child per element over the nursery substrate and joins at the
// boundary, the answers assembling in input order (spawn order is the
// drive order, deterministic replay by construction), and a failing
// element would cancel its siblings and re-raise at the call. The
// single-thread slice: the fork's spawn-and-join overhead against the
// sequential map is the baseline the later scheduler round measures
// from.

fn at(xs: list[int], i: int) -> int {
  const cell = xs.get(i)
  cell.ok((x: int) => x).err((_: none) => -1)
}

fn main() -> () {
  const xs = [1, 2, 3, 4, 5]
  const doubled = xs.par_map((x: int) => x * 2)
  println("doubled ${len(doubled)} ${at(doubled, 0)} ${at(doubled, 4)}")
  const sum = reduce(doubled, 0, (a: int, b: int) => a + b)
  println("sum ${sum}")
}
