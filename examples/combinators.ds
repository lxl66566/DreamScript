// The lambda-taking combinators over CALLG dispatch: map, filter, and
// reduce stage the lambda as one Fn word (a synthesized function), the
// VM reenters the dispatcher per element, and the block-body println
// interleaves in element order. The @std list pair lands the FP
// surface's first members: zip and enumerate over the same list.

fn at(xs: list[int], i: int) -> int {
  const cell = xs.get(i)
  cell.ok((x: int) => x).err((_: none) => -1)
}

fn main() -> () {
  const xs = [1, 2, 3, 4, 5]
  const doubled = xs.map((x: int) => x * 2)
  println("doubled ${doubled.len()} ${at(doubled, 0)} ${at(doubled, 4)}")
  const evens = xs.filter((x: int) => x % 2 == 0)
  println("evens ${evens.len()} ${at(evens, 0)} ${at(evens, 1)}")
  const traced = xs.map((x: int) -> int {
    println("visiting ${x}")
    x * 10
  })
  println("traced ${at(traced, 0)} ${at(traced, 4)}")
  const sum = xs.reduce(0, (a: int, b: int) => a + b)
  const words = ["alpha", "beta"]
  const joined = words.reduce("", (a: string, b: string) => "${a}${b}")
  println("sum ${sum} joined ${joined}")
  const (big, small) = xs.partition((x: int) => x > 2)
  println("split ${big.len()} ${small.len()}")
  const partials = xs.scan(0, (a: int, b: int) => a + b)
  println("scan ${partials.len()} ${at(partials, 2)}")
  const pairs = xs.zip(["x", "y", "z"])
  const numbered = ["a", "b"].enumerate()
  println("zip ${pairs.len()} enum ${numbered.len()} ${xs.enumerate().len()}")
}
