// Anonymous tuples: frame-span aggregates with destructuring in
// bindings and match arms. Every element is one frame word, so a tuple
// never allocates.

fn endpoint(host: string, port: int) -> (string, int) {
  (host, port)
}

fn port_of(pair: (string, int)) -> int {
  const (_, port) = pair
  port
}

fn pick(t: (int, int)) -> string {
  match t {
    (n, m) if (n > 100) => "big"
    (0, 5) => "zero-five"
    (0, _) => "zero"
    _ => "flat"
  }
}

fn main() -> () {
  const t = ("host", 8080)
  const (name, port) = t
  println("${name}:${port}")
  println("port ${port_of(endpoint("db.local", 5432))}")
  match t {
    (host, prt) => println("matched ${host} ${prt}")
  }
  const tagged = ("unit", ())
  const (label, _) = tagged
  println("label ${label}")
  const one = (7,)
  const (seven,) = one
  println("seven ${seven}")
  println(if t == ("host", 8080) { "equal" } else { "unequal" })
  var (host2, port2) = t
  host2 = "db"
  port2 = port2 + 1
  println("var ${host2}:${port2}")
  println("pick ${pick((0, 5))} ${pick((200, 5))} ${pick((0, 9))} ${pick((3, 1))}")
}
