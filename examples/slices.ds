// The @std slice pair over the bodied generic library shape: take
// answers the first n elements and drop the rest after n, both
// clamping at the list's own bounds — a negative, zero, or past-the-end
// n and the empty list all answering the empty or whole list the
// bounds imply. flatten is the flat_map face's composable half: the
// fn-typed parameter's list-returning signature never solves from a
// concrete lambda at the call site (B2 binds a bare return variable
// alone), so the flat spelling composes as flatten over map's hosted
// lambda, the nested-empty edge included — and the fluent spelling
// chains the same pair through a dot-call's receiver, the map call
// staging its hosted lambda inside the position flatten reads.

fn main() -> () {
  const xs = [1, 2, 3, 4, 5]
  println("take ${xs.take(2).len()} ${xs.take(0).len()} ${xs.take(9).len()} ${xs.take(-1).len()}")
  println("edges ${list[int]().take(3).len()} ${xs.take(3).len()}")
  println("drop ${xs.drop(2).len()} ${xs.drop(0).len()} ${xs.drop(9).len()} ${xs.drop(-1).len()}")
  println("edges ${list[int]().drop(2).len()} ${xs.drop(4).len()}")
  const nested = xs.map((x: int) => [x, x * 10])
  println("flat ${nested.flatten().len()} ${nested.flatten().len()}")
  println("fluent ${xs.map((x: int) => [x, x * 10]).flatten().len()}")
  println("empty ${list[list[int]]().flatten().len()} ${[[1], list[int](), [2, 3]].flatten().len()}")
}
