// A write/read round trip through the file-IO natives: write_file, then
// read_file, file_size, and file_exists over the same bytes, comparing
// the round trip by content. Every fallible leg answers the io_err
// union — the write narrows through `is`, the read extracts through the
// `.err` handler, and the size through `?` — so a failed leg answers a
// value instead of halting. The path is fixed relative to the current
// directory.

fn size_of(path: string) -> int | io_err {
  file_size(path)?
}

fn main() -> () {
  const path = "ds_files_example.txt"
  const text = "files round trip"
  const written = write_file(path, text)
  if written is io_err {
    println("write failed")
  }
  const back = read_file(path).err((_: io_err) => "")
  println("read back: ${back}")
  println("size: ${size_of(path).err((_: io_err) => -1)}")
  println("exists: ${file_exists(path)}")
  if back == text {
    println("round trip ok")
  } else {
    println("round trip FAILED")
  }
}
