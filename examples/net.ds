// A minimal TCP client flow: net_connect answering the linear
// net_handle, then the send/recv handlers, and close_conn — against
// 127.0.0.1 on the port named by the first process argument. Without
// one the run prints instructions and exits 0 (no local test server
// assumed); with one, a listener answers and the run prints its reply.
// The reads answer the failure taxonomy's union, so the match names
// the net_err case each failure landed on; the connect keeps the total
// spelling (the handle is deinit-carrying, so a union member holding it
// refuses), and the binding's scope end closes the connection even
// past the explicit close_conn, idempotently. The hermetic proof lives
// in the ds-vm net_io fixtures plus the CLI integration test, which
// spins an in-process listener.

fn main() -> () {
  const argv = args()
  if argv.len() == 0 {
    println("skipped: no local test server")
    println("  start a TCP listener, then run: ds run examples/net.ds --args <port>")
  } else {
    const first = argv.get(0).ok((w: string) => w).err((_: none) => "")
    const port = first.parse_int().err((_: parse_err) => -1)
    if port < 0 {
      println("the port argument is not an int: ${first}")
    } else {
      const conn = net_connect("127.0.0.1", port)
      send(conn, "ping from DreamScript")
      match recv(conn, 64) {
        timeout => println("recv timed out"),
        refused => println("recv refused"),
        reply => println("server replied: ${reply}")
      }
      const closed = close_conn(conn)
      closed
    }
  }
}
