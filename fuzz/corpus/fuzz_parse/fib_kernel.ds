// Kernel: naive recursive fib — call overhead and integer add per call.
// fib(34) keeps every intermediate far inside i64 and f64-exact range.

extern fn str_int (v: int) -> string

const fib = (n: int) -> int {
  if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

const main = () -> () {
  println("result: ${str_int(fib(34))}")
}
