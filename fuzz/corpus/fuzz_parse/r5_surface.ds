enum level { debug, warn(int), fatal(string) }

fn pair(s: string, n: int) -> (string, int) {
  (s, n)
}

fn main() -> () {
  const t = ("db", 8080)
  const (host, port) = pair("db", 8080)
  const one = (7,)
  const (seven,) = one
  match t {
    (h, p) => println("${h}:${p}"),
  }
  const sep = b'\n'
  const unit = ()
  println("${host} ${port} ${seven}")
}
