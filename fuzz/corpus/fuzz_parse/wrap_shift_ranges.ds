// seed: the wrapped-arith, shift, and range operators no seed carried —
// +% -% *% beside the plain family, << >> shifts, and the .. / ..=
// ranges as the for-in iterable and the `in` operand.

fn main () -> () {
  var acc: int = 0
  for i in 0..=4 {
    acc = acc +% i
  }
  for i in 5..9 {
    acc = acc -% i
  }
  acc = acc *% 3
  acc += (1 << 10) + (1024 >> 3)
  if acc in 0..100000 {
    println("inside ${acc}")
  } else {
    println("outside ${acc}")
  }
}
