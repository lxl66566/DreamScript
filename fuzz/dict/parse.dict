# Parser surface for the fuzz_parse target, checked against
# crates/ds-parse/src/grammar.pest. The `or` operator and `is ... or
# return` are retired; their dict slots moved to the replacement method
# family (.unwrap_or/.ok_or/.map_err) and the `none` atom.

kw_const="const"
kw_var="var"
kw_fn="fn"
kw_if="if"
kw_else="else"
kw_match="match"
kw_while="while"
kw_for="for"
kw_in="in"
kw_break="break"
kw_continue="continue"
kw_return="return"
kw_is="is"
kw_struct="struct"
kw_enum="enum"
kw_tag="tag"
kw_type="type"
kw_trait="trait"
kw_impl="impl"
kw_import="import"
kw_pub="pub"
kw_extern="extern"
kw_mut="mut"
kw_nursery="nursery"
kw_spawn="spawn"
kw_defer="defer"
kw_true="true"
kw_false="false"
mode_move="move"
mode_comptime="comptime"
block_sep="##"
doc_comment="///"
attr="#["
interp="$"
interp_brace="${"
raw_hashed="r#\""
open_brace="{"
close_brace="}"
open_paren="("
close_paren=")"
open_bracket="["
close_bracket="]"
arrow="->"
fatarrow="=>"
pathsep="::"
union="|"
isect="&"
diff="-"
neg="~"
opt="?"
wrap_add="+%"
wrap_sub="-%"
wrap_mul="*%"
range=".."
range_inc="..="
shift_left="<<"
shift_right=">>"
logand="&&"
logor="||"
bitxor="^"
ptr_const="*const"
ptr_mut="*mut"
pkg_vis="pub(pkg)"
import_as=" as "
deinit="deinit "
int_suffixed="1_000i64"
int_hex="0xff"
char_lit="'c'"
byte_lit="b'c'"
ok_tail=".ok("
err_tail=".err("
unwrap_or=".unwrap_or("
ok_or=".ok_or("
map_err=".map_err("
atom_none="none"
sep_comma=","
field_colon=":"
import_sigil="@"
import_slash="/"
