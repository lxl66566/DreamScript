# Source surface for the fuzz_check target (parse + check pipeline),
# checked against crates/ds-parse/src/grammar.pest. The `or` operator and
# `is ... or return` are retired; their dict slots moved to the
# replacement method family (.unwrap_or/.ok_or/.map_err) and the `none`
# atom.

kw_const="const"
kw_var="var"
kw_fn="fn"
kw_if="if"
kw_else="else"
