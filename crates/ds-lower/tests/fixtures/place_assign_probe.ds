// Probe: the assignment sugar's place chains — the field store over a
// var-bound struct (plain and nested), the subscript store desugaring to
// the `set` member's own staging, the nesting of both (an element read
// back, its sub-span mutated, the element stored back), and the
// reference-carrying element counts — with the out-of-range store kept
// to the trap test (the place must resolve, no miss answer exists). The
// compound operator walks the same chains: the read copy is the old
// value and the result returns through the same probe.

tag int
tag float
tag string
tag bool

struct list[t]
struct map[k, v]

struct point { x: int, y: int }
struct outer { p: point, n: int, xs: list[int] }
struct named { name: string, n: int }
struct slab { free: list[int] }

extern fn println (s: string) -> ()
extern fn concat (a: string, b: string) -> string
extern fn list_get[t] (xs: list[t], i: int) -> t | none
extern fn list_push[t] (xs: mut list[t], x: t) -> ()
extern fn list_set[t] (xs: mut list[t], i: int, x: t) -> ()
extern fn list_remove[t] (xs: mut list[t], i: int) -> ()
extern fn map_set[k, v] (m: mut map[k, v], key: k, value: v) -> ()
extern fn map_get[k, v] (m: map[k, v], key: k) -> v | none
extern fn len[t] (xs: t) -> int
extern fn unwrap_or[t] (x: t?, y: t) -> t

impl[t] list[t] {
  fn get (self, i: int) -> t | none
  fn push (mut self, x: t) -> list[t]
  fn set (mut self, i: int, x: t) -> list[t]
  fn remove (mut self, i: int) -> list[t]
}

impl[k, v] map[k, v] {
  fn get (self, key: k) -> v | none
  fn set (mut self, key: k, value: v) -> map[k, v]
}

// the plain field store and the nested field path
fn field_paths() -> bool {
  var p = point { x: 1, y: 2 }
  p.x = 10
  p.y = p.x + 5
  var o = outer { p: point { x: 1, y: 2 }, n: 3, xs: [9] }
  o.p.y = 7
  o.n = 9
  o.xs[0] = 5
  p.x == 10 && p.y == 15 && o.p.x == 1 && o.p.y == 7 && o.n == 9 && o.xs.get(0).unwrap_or(-1) == 5
}

// the subscript store desugars to the set member's own call
fn subscripts() -> bool {
  var xs = [1, 2, 3]
  xs[1] = 20
  const spelled = xs.set(2, 30)
  const middle = xs.get(1).unwrap_or(-1)
  const tail = xs.get(2).unwrap_or(-1)
  xs.get(0).unwrap_or(-1) == 1 && middle == 20 && tail == 30 && len(spelled) == 3
}

// the nesting: the element reads back, its sub-span mutates, the element
// stores back through the same set
fn nested_subscript() -> bool {
  var xs = [point { x: 1, y: 2 }, point { x: 3, y: 4 }]
  xs[1].y = 40
  const first = xs.get(0).unwrap_or(point { x: 0, y: 0 })
  const second = xs.get(1).unwrap_or(point { x: 0, y: 0 })
  first.y == 2 && second.y == 40 && second.x == 3
}

// the map's subscript store stages the key word and the value span
fn map_subscript() -> bool {
  var m = map[string, int]()
  m["one"] = 1
  m["two"] = 2
  const one = m.get("one").unwrap_or(-1)
  const two = m.get("two").unwrap_or(-1)
  one == 1 && two == 2 && m.len() == 2
}

// a list of lists: the inner store mutates the inner list, the outer
// store writes the same element word back (an identity the counts keep)
fn nested_lists() -> bool {
  var rows = [[1, 2], [3, 4]]
  rows[1][0] = 30
  const inner = rows.get(1).unwrap_or([0])
  inner.get(0).unwrap_or(-1) == 30
}

// reference-carrying elements: the replaced word releases its count, the
// stored word acquires its own, and the frame drains
fn ref_elements() -> bool {
  var ss = ["a", "b", "c"]
  ss[0] = "z"
  const hold = "b"
  ss.get(2).unwrap_or("?").len() == 1 && ss.get(0).unwrap_or("?") == "z" && hold == "b"
}



// the compound operator over every class the surface spells: the
// arithmetic, shift, and remainder forms over an int element, the
// arithmetic forms over a float element, and a map's value
fn compound_ops() -> bool {
  var xs = [1, 16, 3]
  xs[0] += 5
  xs[1] -= 4
  xs[1] *= 3
  xs[2] /= 2
  xs[1] <<= 2
  xs[1] >>= 1
  xs[2] %= 2
  var fs = [1.5, 2.0]
  fs[0] += 0.25
  fs[1] *= 4.0
  var m = map[string, int]()
  m["a"] = 1
  m["a"] += 5
  m["b"] = 10
  m["b"] -= 2
  xs.get(0).unwrap_or(-1) == 6 &&
    xs.get(1).unwrap_or(-1) == 72 &&
    xs.get(2).unwrap_or(-1) == 1 &&
    fs.get(0).unwrap_or(0.0) == 1.75 &&
    fs.get(1).unwrap_or(0.0) == 8.0 &&
    m.get("a").unwrap_or(-1) == 6 &&
    m.get("b").unwrap_or(-1) == 8
}

// the compound operator over a nested chain: the read copy's leaf
// mutates and the store-backs unwind through the same windows; a field
// path over the var-bound root computes into the leaf word itself
fn compound_nested() -> bool {
  var xs = [point { x: 1, y: 2 }, point { x: 3, y: 4 }]
  xs[1].y += 10
  xs[0].x *= 7
  var rows = [[1, 2], [3, 4]]
  rows[1][0] += 30
  rows[0][1] -= 2
  var o = outer { p: point { x: 1, y: 2 }, n: 1, xs: [9] }
  o.n += 2
  o.p.x += 4
  o.xs[0] *= 3
  xs.get(0).unwrap_or(point { x: 0, y: 0 }).x == 7 &&
    xs.get(1).unwrap_or(point { x: 0, y: 0 }).y == 14 &&
    rows.get(0).unwrap_or([0]).get(1).unwrap_or(-1) == 0 &&
    rows.get(1).unwrap_or([0]).get(0).unwrap_or(-1) == 33 &&
    o.n == 3 &&
    o.p.x == 5 &&
    o.xs.get(0).unwrap_or(-1) == 27
}

// the string `+=`: the concat's result returns through every leaf shape
// (an element, a map value, a field, a field of an element)
fn compound_strings() -> bool {
  var ss = ["a", "b"]
  ss[0] += "x"
  ss[1] += ss.get(0).unwrap_or("")
  var m = map[string, string]()
  m["k"] = "v"
  m["k"] += "w"
  var o = named { name: "n", n: 0 }
  o.name += "!"
  var xs = [named { name: "z", n: 1 }]
  xs[0].name += "?"
  ss.get(0).unwrap_or("") == "ax" &&
    ss.get(1).unwrap_or("") == "bax" &&
    m.get("k").unwrap_or("") == "vw" &&
    o.name == "n!" &&
    xs.get(0).unwrap_or(named { name: "", n: 0 }).name == "z?"
}

// the probe evaluates exactly once, and the read and the store land on
// the element it named
fn compound_once() -> bool {
  var xs = [10, 20, 30]
  var calls = 0
  fn bump() -> int {
    calls = calls + 1
    calls
  }
  xs[bump()] += 1
  xs.get(1).unwrap_or(-1) == 21 && bump() == 2
}

// a compound store per iteration: each read copy, concat result, and
// probe copy dies at its own store, so the loop leaves no count behind;
// the counted probe's answers alternate the second store's index
fn compound_loop() -> bool {
  var ss = ["", ""]
  var xs = [0, 0]
  var calls = 0
  fn bump() -> int {
    calls = calls + 1
    calls
  }
  var i = 0
  while i < 50 {
    ss[i % 2] += "ab"
    xs[i % 2] += 1
    xs[bump() % 2] += 1
    i = i + 1
  }
  xs.get(0).unwrap_or(-1) == 50 &&
    xs.get(1).unwrap_or(-1) == 50 &&
    bump() == 51 &&
    ss.get(0).unwrap_or("").len() == 50 &&
    ss.get(1).unwrap_or("").len() == 50
}

// the field store whose answer is the receiver's own word: the mut-window
// member call's dup rides into the store, the replaced field content
// releasing its own count first — the loop drain pinning every
// iteration's rollover back to baseline. The discard spelling (the
// answer dropped at the use) walks the same member beside it
impl slab {
  fn churn(mut self, n: int) -> () {
    var i = 0
    while i < n {
      var fl = self.free
      const last = fl.len() - 1
      self.free = fl.remove(last)
      self.free.push(last)
      i += 1
    }
    ()
  }

  fn churn_discard(mut self, n: int) -> () {
    var i = 0
    while i < n {
      var fl = self.free
      const last = fl.len() - 1
      fl.remove(last)
      fl.push(last)
      i += 1
    }
    ()
  }
}

fn field_member_answer() -> bool {
  var s = slab { free: [7] }
  s.churn(50)
  const kept = s.free.len()
  var d = slab { free: [9] }
  d.churn_discard(50)
  const kept2 = d.free.len()
  kept == 1 && kept2 == 1
}

// a heap field's replaced content dies at the plain store: two
// overwrites, each old word's count releasing at its own store
fn field_overwrite() -> bool {
  var o = named { name: "a", n: 0 }
  o.name = "bb"
  o.name = "ccc"
  o.name == "ccc" && o.n == 0
}

impl named {
  fn badge(self) -> string { "T" }
}

// the compound operator whose RHS is a member call: the scalar answer
// folds into the element's read copy, the string answer through the
// concat's window and the field leaf, every probe and answer temp dying
// at its own store-back
fn compound_member_answer() -> bool {
  var xs = [10, 20]
  xs[0] += xs.len()
  var o = named { name: "n", n: 0 }
  o.name += o.badge()
  var ss = ["a", "b"]
  ss[1] += o.badge()
  xs.get(0).unwrap_or(-1) == 12 &&
    o.name == "nT" &&
    ss.get(1).unwrap_or("") == "bT"
}

fn main() -> bool {
  field_paths() &&
    subscripts() &&
    nested_subscript() &&
    map_subscript() &&
    nested_lists() &&
    ref_elements() &&
    compound_ops() &&
    compound_nested() &&
    compound_strings() &&
    compound_once() &&
    compound_loop() &&
    compound_member_answer() &&
    field_member_answer() &&
    field_overwrite()
}

// the out-of-range store: the place must resolve or halt (the trap test's
// own leg, never run by main)
fn trap_out_of_range() -> int {
  var xs = [1, 2]
  xs[3] = 9
  0
}

// a compound store's place must resolve: a list's own store refuses the
// out-of-range probe whatever the element's kind, and the inner probe of
// a nesting names the inner list (the trap tests' own legs)
fn trap_compound_int() -> int {
  var xs = [1, 2]
  xs[3] += 1
  0
}

fn trap_compound_string() -> int {
  var ss = ["a", "b"]
  ss[3] += "x"
  0
}

fn trap_compound_nested() -> int {
  var rows = [[1, 2], [3, 4]]
  rows[1][5] += 1
  0
}

// a map's absent key halts at the read: its store would insert, and no
// old value exists to fold into (the compound store and the plain
// nesting alike)
fn trap_compound_map() -> int {
  var m = map[string, int]()
  m["k"] += 1
  0
}

fn trap_nesting_map() -> int {
  var m = map[string, point]()
  m["k"].x = 5
  0
}
