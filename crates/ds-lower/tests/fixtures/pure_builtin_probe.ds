// purpose: the pure-builtin round's source calls lower and run through
// the native rows the mirror routes — the float math family (sqrt, sin,
// cos, atan2, floor, ceil, pow, abs, round, trunc, log, exp, tan)
// answering one f64 word each, total by construction, and the string
// search triple: contains' membership
// bit, the checked char-indexed index_of riding the same ok/none span
// channel as the other checked natives (its answer composing with the
// checked slice), and replace's one left-to-right pass with the inserted
// text never re-scanned. Both the bare and the UFCS call spellings route
// the same rows; the float probes answer the exact IEEE rows the Rust
// side recomputes.

tag int
tag float
tag bool
tag string
tag char
tag none

extern fn println (s: string) -> ()
extern fn sqrt (x: float) -> float
extern fn sin (x: float) -> float
extern fn cos (x: float) -> float
extern fn atan2 (y: float, x: float) -> float
extern fn floor (x: float) -> float
extern fn ceil (x: float) -> float
extern fn pow (base: float, exp: float) -> float
extern fn abs[t] (x: t) -> t
extern fn round (x: float) -> float
extern fn trunc (x: float) -> float
extern fn ln (x: float) -> float
extern fn exp (x: float) -> float
extern fn tan (x: float) -> float
extern fn contains (haystack: string, needle: string) -> bool
extern fn index_of (haystack: string, needle: string) -> int | none
extern fn replace (haystack: string, needle: string, with: string) -> string
extern fn substring (s: string, start: int, end: int) -> string | none
extern fn unwrap_or[t] (x: t?, y: t) -> t

fn main() -> bool {
  println("sqrt ${4.0.sqrt()} floor ${2.5.floor()} ceil ${2.5.ceil()} round ${2.5.round()} trunc ${2.9.trunc()}")
  float_rows() && search_rows() && compose_rows()
}

fn float_rows() -> bool {
  const neg: float = 0.0 - 3.5
  4.0.sqrt() == 2.0 && 2.5.floor() == 2.0 && 2.5.ceil() == 3.0 && neg.floor() == 0.0 - 4.0 && neg.ceil() == 0.0 - 3.0 && 2.0.pow(10.0) == 1024.0 && neg.pow(2.0) == 12.25 && neg.abs() == 3.5 && neg.abs() == 3.5 && 0.0.sin() == 0.0 && 0.0.cos() == 1.0 && 0.0.atan2(1.0) == 0.0 && 2.5.round() == 3.0 && neg.round() == 0.0 - 4.0 && 2.9.trunc() == 2.0 && neg.trunc() == 0.0 - 3.0 && 0.5.round() == 1.0 && 2.999.trunc() == 2.0 && 1.0.exp().ln() == 1.0 && 0.0.exp() == 1.0 && 0.0.tan() == 0.0 && 1.0.ln() == 0.0
}

fn search_rows() -> bool {
  "hello".contains("ell") && !("hello".contains("z")) && "hello".contains("") && "banana".contains("na") && "hello".index_of("l").unwrap_or(-1) == 2 && "hello".index_of("z").unwrap_or(-1) == -1 && "hello".index_of("").unwrap_or(-1) == 0 && "héllo".index_of("l").unwrap_or(-1) == 2 && "banana".replace("na", "NA") == "baNANA" && "aaa".replace("aa", "b") == "ba" && "abc".replace("z", "y") == "abc" && "ab".replace("", "-") == "-a-b-"
}

fn compose_rows() -> bool {
  const hay = "hello world"
  const i = hay.index_of("world").unwrap_or(-1)
  hay.substring(i, i + 5).unwrap_or("") == "world"
}

fn neg_sqrt() -> float {
  (0.0 - 1.0).sqrt()
}

fn sin_probe() -> float {
  1.0.sin()
}

fn atan2_probe() -> float {
  1.0.atan2(0.0)
}

fn round_probe() -> float {
  (0.0 - 2.5).round()
}

fn trunc_probe() -> float {
  2.9.trunc()
}

fn ln_probe() -> float {
  0.5.ln()
}

fn exp_probe() -> float {
  1.5.exp()
}

fn tan_probe() -> float {
  0.5.tan()
}

fn nan_round() -> float {
  (0.0 / 0.0).round()
}

fn nan_ln() -> float {
  (0.0 - 1.0).ln()
}

fn ln_zero() -> float {
  0.0.ln()
}

fn exp_infinite() -> float {
  (1.0 / 0.0).exp()
}
