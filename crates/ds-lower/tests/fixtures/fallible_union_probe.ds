// purpose: the success-typed fallible natives at run level — the
// two-word platform span re-spans into the call's own union per member
// over the error-class mapping (read_file over the io class set,
// parse_int over its one class), so ?, .ok, .err, and match extract
// real values; the path classes adopt the path word the native answers
// into their payload field, the bare classes drop the native-born count
// inside their arms, the *_other floor's member adopts its message field,
// and the parse failure's position rides its member's field (the input
// survives the failing parse and reads again).

tag int
tag string
tag bool
pub enum io_err {
  not_found { path: string }
  permission_denied { path: string }
  already_exists { path: string }
  timed_out
  unexpected_eof
  io_other { msg: string }
}
tag parse_err { pos: int }

extern fn println (s: string) -> ()
extern fn concat (a: string, b: string) -> string
extern fn read_file (path: string) -> string | io_err
extern fn write_file (path: string, contents: string) -> ()
extern fn parse_int (s: string) -> int | parse_err

// .err over the read: the fallback widens into the result, both arms of
// the platform span feed it
fn read_or_empty(path: string) -> string {
  read_file(path).err((_: io_err) => "")
}

// `?` propagation: the read's kept side binds (string sits outside the
// return union), the parse's whole union rides `return e?` — the fully
// contained case where the return itself is the extraction
fn load_count(path: string) -> int | io_err | parse_err {
  const text = read_file(path)?
  return text.parse_int()?
}

// the union value is a first-class binding: match splits it, the
// catchall binder refines to the success member
fn spell(path: string) -> string {
  const cell = load_count(path)
  match cell {
    not_found => "io",
    permission_denied => "io",
    already_exists => "io",
    timed_out => "io",
    unexpected_eof => "io",
    io_other { msg } => "io",
    parse_err { pos } => "parse",
    n => "count ${n}"
  }
}

// parse_int chains: .ok composes with .err over the same union
fn parse_chain(w: string) -> int {
  w.parse_int().ok((n: int) => n).err((_: parse_err) => 0)
}

// a failing parse hands the input's alias back in the span's dead word;
// the input must survive it — the second parse reads it again
fn parse_twice(w: string) -> int {
  const first = w.parse_int().err((_: parse_err) => 0)
  first + w.parse_int().err((_: parse_err) => -1)
}

fn main(path: string, bad: string, missing: string) -> bool {
  write_file(path, "17")
  write_file(bad, "not a number")
  const back = read_file(path)
  println("back ${back.err((_: io_err) => "?")}")
  println("empty ${read_or_empty(missing)}")
  println("spell ${spell(path)} ${spell(bad)} ${spell(missing)}")
  println("chain ${parse_chain("34") + 1} ${parse_chain("x") + 1}")
  println("twice ${parse_twice("7")} ${parse_twice("x")}")
  back.err((_: io_err) => "") == "17" && read_or_empty(missing) == "" && spell(path) == "count 17" && spell(bad) == "parse" && spell(missing) == "io" && parse_chain("34") == 34 && parse_chain("x") == 0 && parse_twice("7") == 14 && parse_twice("x") == -1
}
