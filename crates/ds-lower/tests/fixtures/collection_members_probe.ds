// purpose: the bodiless collection members route to their native seams
// through the member spelling — `push`/`set` mutating through the mut
// window and answering the receiver (a counted alias of it, the D2
// no-hidden-copy discipline: the bound answer observes the receiver's
// later mutations), `get` re-spanning the checked read's ok/none span
// into the call's own union, `concat` answering the joined fresh list
// over its own seam — with a tail-position `push` lowering in place to
// answer its caller.

tag int
tag string
tag bool

struct list[t]
struct map[k, v]

extern fn println (s: string) -> ()
extern fn list_get[t] (xs: list[t], i: int) -> t | none
extern fn list_push[t] (xs: mut list[t], x: t) -> ()
extern fn list_concat[t] (a: list[t], b: list[t]) -> list[t]
extern fn map_set[k, v] (m: mut map[k, v], key: k, value: v) -> ()
extern fn map_get[k, v] (m: map[k, v], key: k) -> v | none
extern fn len[t] (xs: t) -> int

impl[t] list[t] {
  fn get (self, i: int) -> t | none
  fn push (mut self, x: t) -> list[t]
  fn concat (self, other: list[t]) -> list[t]
}

impl[k, v] map[k, v] {
  fn get (self, key: k) -> v | none
  fn set (mut self, key: k, value: v) -> map[k, v]
}

fn grown() -> list[int] {
  var xs = [1, 2]
  xs.push(3)
}

fn main() -> bool {
  var xs = list[int]()
  const g = xs.push(1)
  xs.push(2)
  const hit = xs.get(1)
  const miss = xs.get(9)
  var m = map[string, int]()
  m.set("one", 1)
  const m2 = m.set("two", 2)
  const one = m.get("one")
  const nope = m.get("nope")
  const tail = grown()
  const joined = xs.concat([3])
  len(g) == 2 && len(xs) == 2 && len(joined) == 3 &&
    hit.ok((x: int) => x).err((_: none) => 0) == 2 &&
    miss.ok((x: int) => x).err((_: none) => -1) == -1 &&
    one.ok((x: int) => x).err((_: none) => 0) == 1 &&
    nope.ok((x: int) => x).err((_: none) => -1) == -1 &&
    m2.get("two").ok((x: int) => x).err((_: none) => 0) == 2 &&
    len(tail) == 3
}
