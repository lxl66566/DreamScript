// source: conformance/types_hybrid.ds, trimmed to the M3 runtime contract
// purpose: config-parser flow (probe union standing in for the map/string ambient,
//          bare return, ?, .err, structural ==, interpolation, tail recursion) lowered
//          by ds-lower and executed on the tier-1 VM
// items:
// cfg_err: stage: run
// probe: stage: run
// config: stage: run
// find_num: stage: run
// get_port: stage: run
// load: stage: run
// default_config: stage: run
// main: stage: run
// probe_same: stage: run
// report: stage: run
// count: stage: run

// primitive atoms, ambient per conformance/README.md (no predeclared universe)
tag int
tag float
tag string
tag bool

// the types_hybrid error surface: bare and payload cases minted by one
// enum [B3]; case names enter the tag namespace like standalone tags
enum cfg_err {
  io_err
  missing
  bad_port { got: int }
}

// the probe union: the fixture's stand-in for the `j.fields.get("port")`
// ambient, hand-modeled by the golden ds-vm fixtures
enum probe {
  p_none
  p_num { value: int }
  p_str { text: string }
}

struct config { host: string, port: int, retries: int }

// builtin natives, addressed by ds-lower as pool FuncRefs into the
// reserved `builtin` module
extern fn println (s: string) -> ()
extern fn print (s: string) -> ()

fn find_num(p: probe) -> int | none {
  if p is p_num { p.value } else { none }
}

fn get_port(p: probe) -> int | missing | bad_port {
  const pv = find_num(p)
  if pv is none { return missing }
  if pv >= 1 && pv <= 65535 { pv } else { bad_port(got: -1) }
}

fn load(p: probe) -> config | cfg_err {
  const port = get_port(p)?
  const a = "local"
  const b = "host"
  config { host: "${a}${b}", port, retries: 3 }
}

fn default_config() -> config {
  config { host: "localhost", port: 8080, retries: 3 }
}

fn main(p: probe) -> bool {
  const cfg = load(p).err((e) => {
    match e {
      bad_port { got } => println("bad port ${got}"),
      _ => println("config read failed"),
    }
    default_config()
  })
  const same = cfg == default_config()
  println("same ${same}")
  same
}

fn probe_same(a: probe, b: probe) -> bool {
  a == b
}

fn report(x: float) -> float {
  print("value: ")
  println("${x}")
  x
}

fn count(n: int, acc: int) -> int {
  if n == 0 { acc } else { count(n - 1, acc + 1) }
}
