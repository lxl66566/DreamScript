// The stdlib ambient: the checked-declaration layer of the stdlib (the
// runtime half is the ds-vm builtin core plus the platform handler the
// host installs behind the platform declaration below). Registered as a package member
// before the user's sources; every declaration is `pub` because
// the member's names are the std's surface to other files, not a private
// file. The package namespace is two —
// types and values — so `struct map` and `fn map` coexist, and a name may
// be redeclared by a corpus file only in the other namespace. The
// fallible natives' failure taxonomy is ambient-owned (io_err, net_err,
// parse_err — the runtime discriminants the platform natives answer), so
// the fallible reads return real success unions. The file face is
// stdlib-owned: the `file_handle` struct below is the package's own
// declared type (named apart from the corpus files' own `file`
// declarations, the `io_err`/`io_error` precedent), its externs name
// it, and the deinit closes the handle. The json face is the same
// ownership migrated: the json face (`json` with parse_json/to_json
// and the typed readers) is the reserved @std package's own member
// (std/json.ds, the serialization substrate's interim step), composed
// back after this core for every reading that does not declare the
// dep, so the two stay namespace-identical while the migration runs.
// The string face is the same shape again (std/strings.ds): the pure
// string operations left as extern entries naming the builtin
// natives, composed back after the json face, while the core string
// face stays here (`str`, `concat`, the sort key and content hash,
// the codepoint pair). The net face rides the file face's shape: the `net_handle` struct
// below is the package's own linear connection handle, `net_connect`
// answers it directly, and the ds-source `send`/`recv`/`close_conn`
// handlers read its id word out to the raw `net_send`/`net_recv`/
// `net_close` externs, the deinit closing the connection.
// Every extern here names a callee the lowering answers (a native, a
// generic native, or a rule-routed family); a declaration whose callee
// no table answers was the dead-name footgun this surface shed.
// The library-boundary un-merge's first slice: this file is the shrunk
// core — the members that migrated to the reserved @std package's own
// source (std_members.ds, the demo residue, beside the json and string
// faces' own files) left it, and the merged ambient every undeclaring
// registration serves composes that member file back after this one,
// so the two readings stay namespace-identical while the migration
// runs.

// The default platform: the `ds` CLI is this platform's
// provider, and the checker verifies the package's world usage stays
// inside what it provides. The `proc` capability is the CLI process
// surface: string argv, the environment read, and
// process spawn.
platform "std" provides <console, fsys, net, time, proc>

// The bottom type: the zero-case enum every compile reaches, the return
// type of a call that yields no value. No value inhabits it, so a
// diverging call sits in any value position — the answer unifies
// wherever the position expects one — while a binding, parameter,
// field, or payload typed `never` refuses: the binder would hold a
// value no path produces.
/// The bottom type: no value inhabits it, and a call answering it
/// never returns, so it sits in any value position.
pub enum never { }

/// The copy marker: a type whose words copy carries it; `~Copyable`
/// on a struct declaration opts out.
pub trait Copyable { }

// The show derive's target: one member answering the
// construction spelling; `#[derive(show)]` synthesizes the impl.
/// The text face: one member answering the value's rendered text;
/// `#[derive(show)]` synthesizes the impl.
pub trait show {
  /// The value's rendered text.
  fn show(self) -> string
}
// The primitives carry show themselves, so a generic derive
// instantiates at them and an explicit `.show()` answers anywhere.
/// Carries show through `str`.
impl show for int {
  fn show(self) -> string { str(self) }
}
/// Carries show through `str`.
impl show for float {
  fn show(self) -> string { str(self) }
}
/// Carries show through `str`.
impl show for bool {
  fn show(self) -> string { str(self) }
}
/// Carries show through `str`.
impl show for byte {
  fn show(self) -> string { str(self) }
}
/// Carries show through the char's codepoint conversion.
impl show for char {
  // the hole stages the code point through the char conversion native,
  // so the answer spells the UTF-8 text the scalar names
  fn show(self) -> string { "$self" }
}
/// Answers the string itself.
impl show for string {
  fn show(self) -> string { "$self" }
}
// The bytes representation: `show` renders the payload as
// a byte list — `bytes[1, 2, 255]`, empty printing `bytes[]` — one
// decimal per payload byte over the `list[byte]` bridge. The body
// carries no trapping op (the `concat` extern and a for-in walk, never
// `+`/`+=`): a method call's effect row unions every registered
// candidate's, so a trapping show body would name `trap` at every
// `.show()` call site.
/// Renders the payload as a byte list: `bytes[1, 2, 255]`, empty
/// printing `bytes[]`.
impl show for bytes {
  fn show(self) -> string {
    var out = "bytes["
    var first = true
    for b in byte_list(self) {
      if first { first = false } else { out = concat(out, ", ") }
      out = concat(out, str(b))
    }
    concat(out, "]")
  }
}

// The ord derive's target: ordering is never structural, so one
// member answers the field-order lexicographic
// comparison; `#[derive(ord)]` synthesizes the impl. The primitives
// carry ord themselves, each part's sort key an explicit compare
// native: float through `total_compare` (the IEEE total order, the one
// total comparison the trapping `<`/`>` cannot spell), and string,
// char, and byte through their own compare natives (the UTF-8 byte
// order, the Unicode scalar order, and the u8 order).
/// The ordering face: one member answering the lexicographic
/// comparison; `#[derive(ord)]` synthesizes the impl.
pub trait ord {
  /// Orders two values: negative, zero, or positive.
  fn compare(self, other: Self) -> int
}
/// Orders int by the total order.
impl ord for int {
  fn compare(self, other: Self) -> int {
    if self < other { -1 } else if self > other { 1 } else { 0 }
  }
}
/// Orders bool with false first.
impl ord for bool {
  fn compare(self, other: Self) -> int {
    if self { if other { 0 } else { 1 } } else { if other { -1 } else { 0 } }
  }
}
/// Orders float through the IEEE total order.
impl ord for float {
  fn compare(self, other: Self) -> int { total_compare(self, other) }
}
/// Orders string by the UTF-8 byte order.
impl ord for string {
  fn compare(self, other: Self) -> int { str_compare(self, other) }
}
/// Orders char by the scalar order.
impl ord for char {
  fn compare(self, other: Self) -> int { char_compare(self, other) }
}
/// Orders byte by the u8 order.
impl ord for byte {
  fn compare(self, other: Self) -> int { byte_compare(self, other) }
}
// Bytes order lexicographically over the payload, a shorter prefix
// first, through the collection's own compare native.
/// Orders bytes lexicographically over the payload, a shorter
/// prefix first.
impl ord for bytes {
  fn compare(self, other: Self) -> int { bytes_compare(self, other) }
}

// The hash derive's target: hash stays consistent with universal
// structural `==`, one member answering the content
// hash; `#[derive(hash)]` synthesizes the impl. Every primitive part
// carries hash itself: int and bool mix their own word, byte through
// its decimal text (the atom sits outside the int conversion family),
// string and char through the FNV-1a native over their bytes, and
// float through the fold native (which normalizes -0.0 to +0.0 and
// every NaN payload to the one canonical NaN, the bit-structural
// equality the hash contract requires).
/// The hashing face: one member answering the content hash,
/// consistent with structural equality; `#[derive(hash)]`
/// synthesizes the impl.
pub trait hash {
  /// The value's content hash.
  fn hash(self) -> int
}
/// Hashes the word itself.
impl hash for int {
  fn hash(self) -> int { self }
}
/// Hashes the word as one or zero.
impl hash for bool {
  fn hash(self) -> int { if self { 1 } else { 0 } }
}
/// Hashes the value with -0.0 and NaN normalized.
impl hash for float {
  fn hash(self) -> int { float_hash(self) }
}
/// Hashes the text's bytes under FNV-1a.
impl hash for string {
  fn hash(self) -> int { str_hash(self) }
}
/// Hashes the char's bytes under FNV-1a.
impl hash for char {
  fn hash(self) -> int { char_hash(self) }
}
/// Hashes the byte's decimal text.
impl hash for byte {
  fn hash(self) -> int { str_hash(str(self)) }
}
// Bytes hash their payload content through the FNV-1a native, the one
// scheme the hash family folds under.
/// Hashes the payload bytes under FNV-1a.
impl hash for bytes {
  fn hash(self) -> int { bytes_hash(self) }
}

// The clone derive's target: one member answering the shallow
// duplicate; `#[derive(clone)]` synthesizes the impl. The primitives
// carry clone themselves (the one-word atom answers itself, byte's
// included), so the derived body is a construction over the borrowed
// receiver whose Ref parts dup through the placement pass — a count
// bump per reference, never a deep copy).
/// The duplication face: one member answering the shallow
/// duplicate; `#[derive(clone)]` synthesizes the impl.
pub trait clone {
  /// The value's shallow duplicate.
  fn clone(self) -> Self
}
/// Duplicates by answering the word itself.
impl clone for int {
  fn clone(self) -> Self { self }
}
/// Duplicates by answering the word itself.
impl clone for bool {
  fn clone(self) -> Self { self }
}
/// Duplicates by answering the word itself.
impl clone for float {
  fn clone(self) -> Self { self }
}
/// Duplicates by answering the word itself.
impl clone for string {
  fn clone(self) -> Self { self }
}
/// Duplicates by answering the word itself.
impl clone for char {
  fn clone(self) -> Self { self }
}
/// Duplicates by answering the word itself.
impl clone for byte {
  fn clone(self) -> Self { self }
}
/// Duplicates by answering the word itself.
impl clone for bytes {
  fn clone(self) -> Self { self }
}

// The receiverless member's ambient slice:
// every primitive carries `default` in its own impl, callable as
// `int.default()` through the type-keyed surface with no instance
// word, so a `#[derive(default)]` field dispatches through its own
// type's members like every other family. The char default is the NUL
// code point and byte's the zero byte — the additive-identity
// analogues of the int and float zeros.
/// The int type's `default` member: zero.
impl int { fn default() -> int { 0 } }
/// The float type's `default` member: positive zero.
impl float { fn default() -> float { 0.0 } }
/// The bool type's `default` member: false.
impl bool { fn default() -> bool { false } }
/// The string type's `default` member: the empty text.
impl string { fn default() -> string { "" } }
/// The char type's `default` member: the NUL code point.
impl char { fn default() -> char { '\0' } }
/// The byte type's `default` member: the zero byte.
impl byte { fn default() -> byte { b'\0' } }
/// The bytes type's `default` member: the empty payload.
impl bytes { fn default() -> bytes { bytes_of(list[byte]()) } }
// The collection count's per-type spellings, each routing through the
// one generic native behind the private `len` seam below (the
// instance word the receiver's own type names).
/// The string's `len` member: its char count.
impl string { fn len (self) -> int }
/// The bytes' `len` member: its payload byte count.
impl bytes { fn len (self) -> int }
// The string concatenation member, the `+`/interpolation seam's own
// spelling: the operator lowers through the private `concat` seam
// directly, so this member is the dot-call face over the same native.
/// The concatenation member over the seam the `+` spelling lowers
/// through.
impl string { fn concat (self, other: string) -> string }

// The collection face's member tier: the inherent members the
// runtime seam lowers over the builtin collections. A member whose
// parameter or answer spans the collection's own type variable has no
// static word kind, so the element-carrying spellings keep their
// `list_*`/`map_*` native seams — private below, VM-internal names the
// user surface never spells — and the ordered key face presents as a
// member. The type-specific free functions this core once spelled are
// the member tier's shape too: the combinators, the count, and the
// checked first read are members here, their free spellings the
// private native seams the calls route through.
/// The map's member tier.
impl[k, v] map[k, v] {
  /// The keys in entry order.
  fn keys (self) -> list[k] { map_keys(self) }
  /// The value behind a key, none over a missing one.
  fn get (self, key: k) -> v | none
  /// Sets one key's row, answering the receiver.
  fn set (mut self, key: k, value: v) -> map[k, v]
  // The removal's miss answer: a missing key is a no-op — the row that
  // is not there has nothing to release, and the caller that needs to
  // know composes `contains`/`get` first. The mutation members answer
  // the receiver (the mut-window member shape), so no miss channel
  // exists to extract.
  /// Removes one key's row — a missing key a no-op — answering the
  /// receiver.
  fn remove (mut self, key: k) -> map[k, v]
  /// Whether the key holds a row.
  fn contains (self, key: k) -> bool
  // The entry-order pair face: one `(key, value)` tuple per row, the
  // iteration seam `keys` composes with the value spans in one pass.
  /// The rows as (key, value) tuples, in entry order.
  fn entries (self) -> list[(k, v)]
  /// The row count.
  fn len (self) -> int
}

/// The list's member tier.
impl[t] list[t] {
  /// The element at the index, none out of range.
  fn get (self, i: int) -> t | none
  /// Whether an equal element occurs.
  fn contains (self, x: t) -> bool
  /// Replaces the element at the index, answering the receiver.
  fn set (mut self, i: int, x: t) -> list[t]
  /// Appends one element, answering the receiver.
  fn push (mut self, x: t) -> list[t]
  // The indexed splice and removal: `insert` before `i` appends at
  // `i == len`, `remove` drops the element's words with their counts,
  // and both trap out of range (a store or removal must resolve its
  // place — the checked read keeps the extractable `t | none` miss).
  /// Inserts the element before the index — `i == len` appends —
  /// answering the receiver; traps out of range.
  fn insert (mut self, i: int, x: t) -> list[t]
  /// Removes the element at the index, answering the receiver;
  /// traps out of range.
  fn remove (mut self, i: int) -> list[t]
  /// Removes every element, answering the receiver.
  fn clear (mut self) -> list[t]
  /// The concatenation with the other list.
  fn concat (self, other: list[t]) -> list[t]
  // The count and the checked head read, the collection `len`/`first`
  // family's own spellings over the free tier's retired seams.
  /// The element count.
  fn len (self) -> int
  /// The first element, the optional over an empty list.
  fn first (self) -> t?
  // The combinators: the hosted-lambda transforms and the folds, the
  // callable staging beside the receiver exactly the free spellings'
  // (the member route feeds the receiver as the native's first
  // argument). `map` declares its answer's type parameter on the
  // member, the call site solving it from the callable.
  /// The transform's answers, one per element.
  fn map[r] (self, f: fn(t) -> r) -> list[r]
  /// The elements the predicate accepts, in order.
  fn filter (self, f: fn(t) -> bool) -> list[t]
  /// The accepted and rejected elements as a tuple of two lists.
  fn partition (self, f: fn(t) -> bool) -> (list[t], list[t])
  /// Folds the elements into one over the initial value.
  fn reduce (self, init: t, f: fn(t, t) -> t) -> t
  // The sequence pair: the element-first prepend (`xs.cons(x)` stages
  // the element ahead of the list `Ref`, the native's own order) and
  // the tail drop.
  /// The list with the element prepended.
  fn cons (self, x: t) -> list[t]
  /// The list past its first element.
  fn tail (self) -> list[t]
  // The copy and the no-op pass the identity family spells over the
  // list's own edge.
  /// The list's own copy, the identity family's pass-through.
  fn collect (self) -> list[t]
  // The explicit-comparator sort over the stable merge sort body: the
  // callable stages beside the list, the body reentering it per
  // comparison — the ord-routed spelling's surface over heads that
  // carry no ord instance.
  /// The stable sort under the explicit comparator, answering the
  /// sorted list.
  fn sort_by (self, cmp: fn(t, t) -> int) -> list[t]
  // The sequence slice pair and the enumeration: plain ds bodies over
  // the impl's own variable (the generic member body's one Raw-word
  // shape, its calls the member spellings themselves).
  /// The first n elements, clamped at the list's bounds.
  fn take (self, n: int) -> list[t] {
    var out = list[t]()
    var i: int = 0
    for x in self {
      match i < n {
        true => { out = out.concat([(x)]) }
        _ => {}
      }
      i += 1
    }
    out
  }
  /// The elements past the first n, clamped at the list's bounds.
  fn drop (self, n: int) -> list[t] {
    var out = list[t]()
    var i: int = 0
    for x in self {
      match i < n {
        true => {}
        _ => { out = out.concat([(x)]) }
      }
      i += 1
    }
    out
  }
  /// The (index, element) pairs.
  fn enumerate (self) -> list[(int, t)] {
    var out = list[(int, t)]()
    var i: int = 0
    for x in self {
      out = out.concat([(i, x)])
      i += 1
    }
    out
  }
}

// The ord-routed list sort: the declared bound is the routing — the
// call site's solved element type names its serving ord instance, and
// the lowering stages that instance's `compare` body as the callable
// word beside the list, so the native's stable merge sort reenters
// through it per comparison (the reduce seam's CALLG discipline).
/// The ord-routed sort: the element type's ord instance supplies
/// the comparator.
impl[t: ord] list[t] {
  /// The stable sort under the element type's ord instance,
  /// answering the sorted list.
  fn sort (self) -> list[t]
}

// The nested-list splice: one flat body over the element's own type
// parameter, each inner list concatenated onto the answer.
/// The nested-list splice.
impl[r] list[list[r]] {
  /// The inner lists concatenated in order.
  fn flatten (self) -> list[r] {
    var out = list[r]()
    for ys in self {
      out = out.concat(ys)
    }
    out
  }
}

// The int list's own total, the reduce seam's specialized member: the
// hosted add folds the list from zero.
/// The int list's own total.
impl list[int] {
  /// The elements' total, folding from zero.
  fn sum (self) -> int {
    self.reduce(0, (a: int, x: int) => a + x)
  }
}

// The channel face: the net handle's plain receiver discipline (the
// word is a shared handle, the mutation the object's own state, the
// language's one shared-state exception). `send` answers unit, `recv` the payload;
// both park the calling fiber when the buffer cannot serve it, the
// wake delivering at the parked call site. The deadline twins bound
// the same wait: the winner answers the ok unit or the element's word,
// the deadline-cut loser the io taxonomy's own `timed_out` member (the
// timer race's loser shape at the parked call), the loser's waiter
// entry deregistered from the channel's own queue either door.
/// The channel's member tier.
impl[t] chan[t] {
  /// Deposits one element, parking the sender on a full buffer;
  /// answers unit.
  fn send (self, x: t) -> ()
  /// Takes the head element, parking the receiver on empty.
  fn recv (self) -> t
  /// Sends under a deadline: the deposited unit, or timed_out at
  /// the cut.
  fn send_deadline (self, nanos: int, x: t) -> () | timed_out
  /// Receives under a deadline: the head element, or timed_out at
  /// the cut.
  fn recv_deadline (self, nanos: int) -> t | timed_out
}

// The arena face (the read-side aliasing container): every member
// takes the `mut` window over the arena's own word (the one
// exclusively-held owner mutates and reads; handles cross calls as
// plain copyable ints). `insert` answers the packed handle, `remove`
// the tombstone (the slot's generation bumping at the removal, every
// handle copy taken before it going stale at once), `at` the element
// behind a live handle as one counted share, the arena keeping its
// own — a mutating native on the shared-count answer copies, so
// building cyclic graphs through `at` answers is dead for reference
// elements until the read-side aliasing round — and a dangling handle
// traps deterministically at either member.
/// The arena's member tier.
impl[t] arena[t] {
  /// Stores one element, answering its packed handle.
  fn insert (mut self, x: t) -> int
  /// Tombstones the handle's slot, releasing the element.
  fn remove (mut self, h: int) -> ()
  /// The element behind a live handle; a stale handle traps.
  fn at (mut self, h: int) -> t
  /// The element count.
  fn len (self) -> int
}

// The owning container's member tier: the runtime seam lowers over the
// heap application. `get` copies the held value out (the container
// keeps its edge), `set` replaces it through the mut window — the
// container's own object at a unique count, a fresh copy at a shared
// one — and answers the receiver's post-mutation word; the held value's
// whole span stages at both seams.
/// The owning container's member tier.
impl[t] box[t] {
  /// The held value, copied out (the container keeps its own).
  fn get (self) -> t
  /// Replaces the held value, answering the receiver.
  fn set (mut self, x: t) -> box[t]
}

/// The 64-bit signed integer type.
pub tag int
/// The 64-bit IEEE float type.
pub tag float
/// The true/false type.
pub tag bool
/// The UTF-8 text type: one immutable counted block behind one word.
pub tag string
/// The Unicode scalar type.
pub tag char
// The b'x' literal's atom: its own u8 width class, outside
// the int conversion family.
/// The u8 byte type, the `b'x'` literal's atom.
pub tag byte
// The byte sequence's collection atom: one immutable byte string per
// value — the string face's shape over raw bytes, one counted block
// behind one Ref word (never a per-element word list). Constructed
// through `bytes_of` below; `len` counts its payload bytes, `byte_at`
// reads one checked, and `byte_list` bridges back to `list[byte]`.
/// The immutable byte-sequence type: one counted payload block behind one word.
pub tag bytes
/// The unsigned 32-bit integer type; constructed through `u32.of`.
pub tag u32

/// The growable ordered list, one heap-backed word per value.
pub struct list[t]
/// The insertion-ordered key-value map.
pub struct map[k, v]
// The bounded channel: the one
// inter-fiber shared-state vocabulary — no lock, mutex or atomic ever
// enters the language. One opaque word behind one heap object on the
// creating fiber's store (the one owning heap): the word copies into a
// spawned child's captures exactly a list word's, `send` deposits one
// payload element — its whole word span at the buffer's element stride,
// a scalar or reference word or a pure-word record, tuple, or union
// member span — parking the sender on a full buffer, `recv` takes the
// head parking the receiver on empty, and a payload crossing fibers
// transfers one count per reference word through the claim ledger. A
// deinit-carrying payload refuses at the send (the buffer's edge
// retention owns counts, never claims), and a channel every fiber has
// parked on is the honest deadlock: no sender, no answer.
/// The bounded channel between fibers: send parks on a full
/// buffer, recv on empty.
pub struct chan[t]

// The read-side aliasing container: the library
// shape for cyclic graphs, node trees, ECS, and cross-call cursors —
// no language change. One opaque word behind one heap object on the
// owning fiber's store, the payload a slot array of one element word
// per handle with a per-slot generation counter: `insert` answers a
// copyable handle (the index and generation packed into one int word,
// so the handle keeps scalar provenance through every value position),
// `remove` tombstones the slot onto the free list with the generation
// bumping at the removal, and a stale handle — any copy taken before it
// — traps deterministically instead of naming the reused element. Elements stage one word (a scalar or reference
// word; a multi-word record or a deinit-carrying value refuses at the
// insert's staging), and a reference element is a counted share: the
// arena's store owns one edge count per element, released at the
// remove or the arena's death. The hand-rolled handle-plus-table
// alternative stays observable beside it — the bypass tax the
// generational-reference trigger measures against this vocabulary.
/// The handle-addressed slot array: insert answers a packed
/// handle, a stale handle traps.
pub struct arena[t]

// The owning container: the explicit pointer to one heap-held value —
// the recursion spelling a self-containing field refuses inline. One
// opaque word behind one heap object holding the value's whole word
// span, one owned count per reference word: `box[t](v)` moves v in,
// `b.get()` copies the held value out, `b.set(x)` replaces it in place
// through the mut window. A `~Copyable` value refuses the container —
// the container's death owns counts, never claims, so the value's
// deinit has no firing position — and a declaration spelling its
// recursion through `box` lays out, where the same recursion without it
// keeps the cyclic-field refusal.
/// The owning container for one heap-held value.
pub struct box[t]

// The json value family, the typed face over the JSON grammar: one case
// per grammar shape, the number split kept faithful (a token with a
// decimal point or an exponent, or an integer literal past the int
// range, answers json_float — an in-range integer literal answers
// json_int, and the two never narrow into each other). The type stays
// pinned at this declaration position (its case atoms mint here, and
// the compile seams address ambient mint order positionally); the
// parser, serializer, and typed readers live in the @std json face's
// own source (std/json.ds), composed after this core.
/// The JSON value family: one case per grammar shape, int and
/// float kept split.
pub enum json {
  json_null
  json_bool { value: bool }
  json_int { value: int }
  json_float { value: float }
  json_string { value: string }
  json_array { items: list[json] }
  json_object { fields: map[string, json] }
}

// The failure taxonomy of the fallible natives: `io_err` and
// `net_err` are declaration-keyed enums, each native failure landing
// on its class and the classes a platform cannot discriminate
// portably folding into the `*_other` floors — the path classes name
// the path they failed on, and the OS message string rides the
// `*_other` floors alone. Signatures spell the enum; `?` checks
// membership by set containment. `parse_err` carries the position the
// parse gave up at (the offset into the input document; a shape failure
// over an already-decoded value answers 0, no position existing there),
// and `utf8_err` stays one bare tag. never parse_err for the bytes
// decode bridge — it names document shape failures alone.
/// The io failure union the fsys natives answer: one class case per
/// failure kind, the path classes carrying the path they failed on.
pub enum io_err {
  /// The io class for a missing path.
  not_found { path: string }
  /// The io class for an access denial.
  permission_denied { path: string }
  /// The io class for an existing entry.
  already_exists { path: string }
  /// The io class for an expired deadline.
  timed_out
  /// The io class for input ending early.
  unexpected_eof
  /// The io floor: a failure no class discriminates, carrying the OS message.
  io_other { msg: string }
}

/// The net failure union the net natives answer: one class case per
/// failure kind, the floor alone carrying the OS message.
pub enum net_err {
  /// The net class for a timed-out operation.
  timeout
  /// The net class for a refused connection.
  refused
  /// The net class for a bound address.
  addr_in_use
  /// The net class for a reset connection.
  reset
  /// The net floor: a failure no class discriminates, carrying the OS message.
  net_other { msg: string }
}

/// A parse failure carrying the offset it gave up at.
pub tag parse_err { pos: int }
/// A UTF-8 validation failure.
pub tag utf8_err

// The file face: the package-owned linear handle over the fsys
// capability. `open_file` answers this type directly (its one inline word is
// the handle), while `read_exact` and `close_file` are ds-source
// handlers over the raw `read_raw`/`close_raw` externs — a native
// call cannot borrow a deinit-carrying argument, so the handlers read
// the fd word out and hand the raw seam an int. The deinit closes the
// handle (a file binding dropped without an explicit close_file still ends
// clean), and `close_raw` is idempotent because the deinit may fire on
// a handle the owner already closed. The handle word is an opaque
// table key, never the OS descriptor, and `read_exact` answers
// `bytes | io_err` (the read's payload is one immutable byte string,
// one counted block per read).
/// The linear file handle; the deinit closes it.
pub struct file_handle: ~Copyable {
  fd: int
  deinit { close_raw(self.fd) }
}

// The net face: the same shape over the net capability — the
// package-owned linear handle whose one inline word is the connection
// table's key. `net_connect` answers this type directly (the total
// spelling, since the handle is deinit-carrying), while `send`,
// `recv`, and `close_conn` are ds-source handlers over the raw
// `net_send`/`net_recv`/`net_close` externs — a native call cannot
// borrow a deinit-carrying argument, so the handlers read the id word
// out and hand the raw seams an int, the fallible reads answering the
// `net_err` union. The deinit closes the connection
// (a binding dropped without an explicit close_conn still ends clean),
// and `net_close` is idempotent because the deinit may fire on a
// handle the owner already closed. The handle word is an opaque table
// key, never the OS descriptor.
/// The linear connection handle; the deinit closes it.
pub struct net_handle: ~Copyable {
  conn: int
  deinit { net_close(self.conn) }
}

// The comptime reflection vocabulary: the one record `fields`
// answers over declared data — a struct's fields and an enum's cases
// share the (name, type, tag) triple. A field's record: its declared
// name, its type as a type value, and its nominal tag name when its
// type is a bare atom (empty for composite field types). A case's
// record: its declared name, its payload as a type value (the case's
// own minted atom, or none when the case constructs bare), and its own
// constructor tag name. The two builtins run inside comptime functions
// only; the checker refuses calls elsewhere.
/// One `fields` row: a declared name, its type as a type value,
/// and its bare atom's name (empty for composite types).
pub struct field { name: string, type: type, tag: string }
/// A struct's fields or an enum's cases, one row each; comptime
/// only.
pub extern fn fields (t: type) -> list[field]
/// A type's declared name; comptime only.
pub extern fn type_name (t: type) -> string

// The list-combinator seams, the member tier's own natives: the
// type-specific free spellings this core once served are the member
// tier's now (the impls above), so these externs are the private
// routing seams their calls lower through — same-file here, invisible
// to every other file.
extern fn map[t, r] (xs: list[t], f: fn(t) -> r) -> list[r]
extern fn cons[t] (x: t, xs: list[t]) -> list[t]
extern fn tail[t] (xs: list[t]) -> list[t]
extern fn box_new[t] (x: t) -> box[t]
extern fn box_get[t] (b: box[t]) -> t
extern fn box_set[t] (b: mut box[t], x: t) -> box[t]
extern fn list_new[t] () -> list[t]
extern fn list_len[t] (xs: list[t]) -> int
extern fn list_get[t] (xs: list[t], i: int) -> t | none
extern fn list_contains[t] (xs: list[t], x: t) -> bool
extern fn list_concat[t] (a: list[t], b: list[t]) -> list[t]
extern fn list_push[t] (xs: mut list[t], x: t) -> list[t]
extern fn list_set[t] (xs: mut list[t], i: int, x: t) -> list[t]
extern fn list_remove[t] (xs: mut list[t], i: int) -> list[t]
extern fn list_insert[t] (xs: mut list[t], i: int, x: t) -> list[t]
extern fn list_clear[t] (xs: mut list[t]) -> list[t]
extern fn map_new[k, v] () -> map[k, v]
extern fn map_set[k, v] (m: mut map[k, v], key: k, value: v) -> map[k, v]
extern fn map_get[k, v] (m: map[k, v], key: k) -> v | none
extern fn map_len[k, v] (m: map[k, v]) -> int
// The ordered key face: the map's entry order, one word per key — the
// iteration seam the checked reads and the inherent `keys` member
// compose over (the value spans read back through the member route).
extern fn map_keys[k, v] (m: map[k, v]) -> list[k]
// The mutation and membership seams behind the member spellings above:
// each mutating seam answers the receiver's post-mutation word (its own
// object at a unique count, a fresh copy at a shared one), the removal's
// missing key a no-op, the membership read answering the
// bit, and the entry-order pair list one key word then the value span
// per row (the fresh list's edge owning one count per reference word).
extern fn map_remove[k, v] (m: mut map[k, v], key: k) -> map[k, v]
extern fn map_contains[k, v] (m: map[k, v], key: k) -> bool
extern fn map_entries[k, v] (m: map[k, v]) -> list[(k, v)]
// The bounded channel's native face: the construction is the type
// application `chan[t](cap)` (the bound the one value argument the
// collection construction form carries — the payload type never reaches
// the code), so `chan_new` stays a private seam like `list_new`'s, and
// `chan_send`/`chan_recv` the private seams behind the member spellings
// above.
extern fn chan_new[t] (cap: int) -> chan[t]
extern fn chan_send[t] (ch: chan[t], x: t) -> ()
extern fn chan_recv[t] (ch: chan[t]) -> t
// The deadline twins behind the member spellings above: the winner
// rides the ok discriminant, the deadline-cut loser the `timed_out`
// class span, so the union re-spans at the call exactly the timer
// race's. A wider element answer refuses at the seam's one-word
// adoption (the timer race's own boundary).
extern fn chan_send_deadline[t] (ch: chan[t], nanos: int, x: t) -> () | timed_out
extern fn chan_recv_deadline[t] (ch: chan[t], nanos: int) -> t | timed_out
// The arena's native face: the construction is the type application
// `arena[t]()` (the element type never reaches the code, every arena
// one Ref word), so `arena_new` stays a private seam like `list_new`'s,
// and `arena_insert`/`arena_remove`/`arena_at` the private seams
// behind the member spellings above (the handle a plain int word).
extern fn arena_new[t] () -> arena[t]
extern fn arena_insert[t] (a: mut arena[t], x: t) -> int
extern fn arena_remove[t] (a: mut arena[t], h: int) -> ()
extern fn arena_at[t] (a: mut arena[t], h: int) -> t
// The bytes collection's native face: `bytes_of` is the construction
// seam (the `list[byte]` bridge in — one payload byte per element word),
// `byte_list` the bridge back out (one word per byte), `byte_at`
// the checked indexed read (the checked-API convention: the in-range byte under
// the ok discriminant, none outside the payload's range — never a
// clamp and never a trap), and the two string bridges one UTF-8 face
// each way: `utf8_encode` takes the string's own bytes,
// and `utf8_decode` validates UTF-8 on the way back, an invalid
// sequence answering the taxonomy's utf8_err tag.
/// Builds bytes from the byte list, one payload byte per element.
pub extern fn bytes_of (xs: list[byte]) -> bytes
/// The bytes back out as a byte list, one element per payload
/// byte.
pub extern fn byte_list (b: bytes) -> list[byte]
/// The payload byte at the index, none out of range.
pub extern fn byte_at (b: bytes, i: int) -> byte | none
/// The string's own UTF-8 bytes.
pub extern fn utf8_encode (s: string) -> bytes
/// Validates the bytes as UTF-8, answering the text or utf8_err.
pub extern fn utf8_decode (b: bytes) -> string | utf8_err
// The generic count's native seam: the collection `len` family's
// member spellings (list, map, string, bytes, arena) each route here
// over the instance table, the private seam the member calls lower
// through — one body for every receiver.
extern fn len[t] (xs: t) -> int
// The float math family: IEEE f64 semantics over the float type, total
// by construction — no operand shape traps (a negative sqrt or ln
// answers NaN, a NaN or infinite operand answers
// itself). `atan2` takes (y, x), the quadrant read off both signs;
// `pow` takes (base, exp). `round` and `trunc` cover the float width
// alone; `abs` joins the int width on the same spelling — the solved
// argument type picks the numeric instance (int answers int, float
// float), an `i64::MIN` magnitude trapping like the arithmetic family's
// overflow, and any other width refusing at the call's lowering.
/// The square root; a negative operand answers NaN.
pub extern fn sqrt (x: float) -> float
/// The sine of a float (radians).
pub extern fn sin (x: float) -> float
/// The cosine of a float (radians).
pub extern fn cos (x: float) -> float
/// The arctangent of (y, x), quadrant-aware.
pub extern fn atan2 (y: float, x: float) -> float
/// The greatest whole float at or below the value.
pub extern fn floor (x: float) -> float
/// The least whole float at or above the value.
pub extern fn ceil (x: float) -> float
/// The base raised to the exponent.
pub extern fn pow (base: float, exp: float) -> float
/// The absolute value; the solved argument type picks int or
/// float.
pub extern fn abs[t] (x: t) -> t
// The fixed-point float formatter: exactly `digits` fraction digits
// (half-to-even at the cut over the value's exact binary expansion),
// the width riding 0..=767 — the widest exact f64 fraction — clamped
// at both sides, never trapping. NaN and the infinities answer the
// `str` spelling's own words.
/// The fixed-point spelling: exactly the digit count of fraction
/// digits, half-to-even at the cut.
pub extern fn str_fixed (x: float, digits: int) -> string
/// The nearest whole float, halves to even.
pub extern fn round (x: float) -> float
/// The value with its fraction dropped, toward zero.
pub extern fn trunc (x: float) -> float
/// The natural logarithm.
pub extern fn ln (x: float) -> float
/// e raised to the value.
pub extern fn exp (x: float) -> float
/// The tangent of a float (radians).
pub extern fn tan (x: float) -> float

// The ordering pairs on the primitives' own member tiers, one
// declaration per value-namespace name holding no more. The float
// comparison answers the partial order: a NaN first operand poisons
// the answer, a NaN second operand loses. The int pair spells the
// total order directly. The free generic pair below routes through
// each operand type's ord instance.
/// The float pair: the partial order, a NaN first operand poisoning the answer.
impl float {
  /// The larger operand; a NaN first operand answers NaN, a NaN
  /// second loses.
  fn max (self, other: float) -> float {
    if self < other { other } else { self }
  }
  /// The smaller operand; a NaN first operand answers NaN, a NaN
  /// second loses.
  fn min (self, other: float) -> float {
    if other < self { other } else { self }
  }
}
/// The int pair: the total order.
impl int {
  /// The larger operand.
  fn max (self, other: int) -> int {
    if self < other { other } else { self }
  }
  /// The smaller operand.
  fn min (self, other: int) -> int {
    if self < other { self } else { other }
  }
}

// The core string face's own concatenation seam: the `+` and `+=`
// spellings lower through it beside the interpolation's STRCAT, the
// `concat` member above routes its calls here, and the bytes show body
// below calls it — the core body's same-file call pins it here. The
// seam is the native the operator lowers through directly, so the
// private spelling never leaves this file. The pure string
// operations over the face (the checked slice and char read, the
// case pair, the separator pair, the search family, the parses) are
// the @std string face's own source (std/strings.ds), composed back
// after the json face for every reading that does not declare the
// dep.
extern fn concat (a: string, b: string) -> string
// The codepoint pair, the @std json face's one native seam beside the
// width bridges below: the scalar range and the code point's integer
// spelling are not expressible in ds source, so the escape decoder
// builds its chars through `char_of` and the serializer's control-char
// escaping reads a codepoint through `code_of`. `char_of` answers none
// outside the scalar range; `code_of` reads the char's scalar.
/// The scalar for a code point, none outside the scalar range.
pub extern fn char_of (code: int) -> char | none
/// The char's code point.
pub extern fn code_of (c: char) -> int
// The byte and u32 width bridges: byte sits outside the int
// conversion family and u32 carries no literal or constructor, so
// crossing either width is not expressible in ds source — the json face's
// byte/u32 readers build their values through these. `byte_of`/`u32_of`
// answer the in-range word or none (the checked-API convention); the read-back pair
// answers the word's number for the json_int construction.
/// The byte for an int, none outside 0-255.
pub extern fn byte_of (n: int) -> byte | none
/// The byte's number.
pub extern fn int_of_byte (b: byte) -> int
/// The u32 for an int, none outside the u32 range.
pub extern fn u32_of (n: int) -> u32 | none
/// The u32's number.
pub extern fn int_of_u32 (v: u32) -> int
// The trap primitive's own spelling (the builtin behind `die` and the
// abort below): private to this file, so no user compile gains a bare
// trap — the member below routes through it the way every native-keyed
// extern does, the lowerer reading the callee by name alone. The
// message rides the Die trap out to the drive, so the CLI's trap report
// prints a u32 range failure exactly like `die`; the declared return is
// `never` — the primitive never answers, so the call sits in any value
// position and the check skips its containment.
extern fn trap (msg: string) -> never
// The policy-free abort over the trap primitive: the deliberate-bug
// spelling every source sharing the ambient reaches, library packages
// included. The message rides the Die trap out to the drive — the
// engine prints nothing and decides no exit code, the host's policy
// applying above it (the CLI's `die` provision rides the same
// primitive) — and the return is `never`, so the call sits in any
// value position: a statement, a handler arm, a block tail, the
// folded main's tail.
/// The policy-free abort with the message; never answers, so the
/// call sits in any value position.
pub extern fn panic (msg: string) -> never
// The u32 width's trapping construction:
// the receiverless member answers the in-range word and traps out of
// range naming the value and the range — the checked `u32_of` above
// stays the fallible form. It rides the u32 type's own static tier (the
// `int.default()` precedent, called `u32.of(x)`): a free fn named `u32`
// cannot carry the bare call form `u32(x)`, since a call-form name in
// both namespaces is the two-namespace ambiguity error and a top-level
// fn's name binds through the type namespace first.
/// The u32 type's static tier.
impl u32 {
  /// The in-range word for the int, trapping out of range.
  fn of (n: int) -> u32 {
    const w = u32_of(n)
    if w is none { trap("u32: ${str(n)} is out of range 0..4294967295") } else { w }
  }
}
// The list fold and filter seams behind the member spellings above
// (the same privacy as the combinator family's).
extern fn collect[t] (xs: list[t]) -> list[t]
extern fn first[t] (xs: list[t]) -> t?
extern fn filter[t] (xs: list[t], f: fn(t) -> bool) -> list[t]
extern fn partition[t] (xs: list[t], f: fn(t) -> bool) -> (list[t], list[t])
extern fn reduce[t] (xs: list[t], init: t, f: fn(t, t) -> t) -> t
// The ord-routed pair and list sort's native seams: the source
// spellings declare no comparator parameter, so each call site routes
// one out of the solved operand type's serving ord instance — the
// `compare` body's callable word staging beside the operands.
/// The larger operand under its type's ord instance; ties answer the first.
pub extern fn max[t: ord] (a: t, b: t) -> t
/// The smaller operand under its type's ord instance; ties answer the first.
pub extern fn min[t: ord] (a: t, b: t) -> t
extern fn sort[t: ord] (xs: list[t]) -> list[t]
// The explicit-comparator sort's native seam, `sort_by`'s own.
extern fn sort_by[t] (xs: list[t], cmp: fn(t, t) -> int) -> list[t]
/// Any value's rendered text.
pub extern fn str[t] (v: t) -> string
/// The IEEE total order over two floats: negative, zero, or
/// positive.
pub extern fn total_compare (a: float, b: float) -> int
/// The UTF-8 byte order over two strings.
pub extern fn str_compare (a: string, b: string) -> int
/// The scalar order over two chars.
pub extern fn char_compare (a: char, b: char) -> int
/// The u8 order over two bytes.
pub extern fn byte_compare (a: byte, b: byte) -> int
// The bytes collection's sort key and content hash, the `ord`/`hash`
// spellings bytes parts ride (lexicographic over the payload, a
// shorter prefix first; FNV-1a over the payload bytes).
/// The lexicographic payload order over two bytes values.
pub extern fn bytes_compare (a: bytes, b: bytes) -> int
/// The FNV-1a content hash over the string's bytes.
pub extern fn str_hash (s: string) -> int
/// The float's content hash, -0.0 and NaN normalized.
pub extern fn float_hash (f: float) -> int
/// The FNV-1a content hash over the char's bytes.
pub extern fn char_hash (c: char) -> int
/// The FNV-1a content hash over the payload.
pub extern fn bytes_hash (b: bytes) -> int
/// Prints the text with a trailing newline.
pub extern fn println (msg: string) -> ()
/// Prints the text.
pub extern fn print (msg: string) -> ()
// The console face's stderr twins and stdin read (the CLI process
// surface): the error stream mirrors the stdout pair, and
// `read_line` answers one stdin line per call, the checked none member
// at end of input.
/// Prints to the error stream with a trailing newline.
pub extern fn eprintln (msg: string) -> ()
/// Prints to the error stream.
pub extern fn eprint (msg: string) -> ()
/// One stdin line per call, none at end of input.
pub extern fn read_line () -> string | none
/// One file's whole text, or its io failure.
pub extern fn read_file (path: string) -> string | io_err
// The path face answers the io_err union the way `read_file` does: each
// platform failure lands on its class, so `?`, the `.ok`/`.err` handlers,
// and match extract a real member and a handled failure neither prints
// nor halts. `write_file` answers the unit member, `fs_list` the sorted
// entry names, and `file_size` the entry's byte count. None of the three
// sits in tail position (a tail call to a fallible native refuses at
// lowering).
/// Writes the text to the path, replacing what is there;
/// answers unit or the io failure.
pub extern fn write_file (path: string, contents: string) -> () | io_err
/// Whether the path names an entry, or its io failure.
// The existence probe answers `bool | io_err`: a path the process can
// stat answers its presence, an absent path the false side, and a
// stat failure its io_err class (a directory the process cannot read
// answering `permission_denied` with the path it failed on).
pub extern fn file_exists (path: string) -> bool | io_err
/// The directory's entry names, sorted, or its io failure.
pub extern fn fs_list (dir: string) -> list[string] | io_err
/// The entry's byte count, or its io failure.
pub extern fn file_size (path: string) -> int | io_err
// The fsys path face: `mkdir` creates one directory a single level deep
// (`already_exists` the branchable outcome), `remove` deletes one entry
// whatever it is (a directory only once empty, the non-empty directory
// answering the `io_other` floor), and `fs_size` answers the entry's byte
// count — each failure landing on its io_err class.
/// Creates one directory level; answers unit or the io failure.
pub extern fn mkdir (path: string) -> () | io_err
/// Deletes one entry (a directory only once empty); answers unit
/// or the io failure.
pub extern fn remove (path: string) -> () | io_err
/// The entry's byte count, or its io failure.
pub extern fn fs_size (path: string) -> int | io_err
/// Opens the path's file, answering the linear handle; a failed
/// open halts.
pub extern fn open_file (path: string) -> file_handle
/// Reads up to n bytes from the raw descriptor, or its io failure.
pub extern fn read_raw (fd: int, n: int) -> bytes | io_err
/// Closes the raw descriptor, idempotently.
pub extern fn close_raw (fd: int) -> ()
// The clock pair: `time` answers epoch nanoseconds (the wall clock —
// durations measured over it bend with the host's clock adjustments),
// `mono` monotonic nanoseconds since a process-fixed origin that never
// moves backward, the word whose differences measure elapsed time.
/// The wall clock's epoch nanoseconds.
pub extern fn time () -> int
/// Monotonic nanoseconds since a process-fixed origin: the word
/// whose differences measure elapsed time.
pub extern fn mono () -> int
// The parking sleep: parks the calling fiber for at least the given
// nanoseconds (a negative span answering at once) — the timer-only
// wait over the deadline wheel; under no
// installed reactor the blocking twin sleeps the thread.
/// Parks the calling fiber for at least the given nanoseconds.
pub extern fn sleep (nanos: int) -> ()
// The timer race: `timeout(nanos, thunk)` runs the callable as the
// calling fiber's racer while the caller parks on the deadline. The
// racer's answer is the call's answer when it lands first; a deadline
// that passes first cuts the racer — at its park or its teardown
// drain, its kept deinits firing — and the call answers the io
// taxonomy's own `timed_out` member, so `?`, `.err`, and match handle
// the deadline through the ordinary error machinery and io-handling
// callers absorb it by set containment. A deadline already past
// answers the failure member at once and the racer never runs; the
// answer spans one word beside the member (a scalar, a reference, a
// one-field record, or a tag-only union); a racer that never parks
// spins past its deadline until the shutdown guard owns it.
/// Races the callable against the deadline: its answer, or
/// timed_out when the deadline cuts first.
pub extern fn timeout[t] (nanos: int, thunk: fn() -> t) -> t | timed_out
// The local offset read (the datetime face's one world touch): the
// host's local UTC offset for the timestamp, seconds east of UTC
// (west negative) — seconds, not the clock pair's nanoseconds, the
// calendar granularity. Total over the CRT's honest window and
// clamped past it; the calendar math and the fixed-shape formatting
// compose in @std ds source over this word.
/// The host's local UTC offset for the timestamp, seconds east
/// of UTC.
pub extern fn utc_offset (unix_seconds: int) -> int
// The process face (the CLI process surface): `args`
// answers the process arguments the host staged (`ds run`'s `--args`
// words) as a list of strings, `env` reads one process environment
// variable into the checked none member when unset, and `proc_run`
// spawns one child over the argument list — inheriting the standard
// streams — and answers its exit status, a spawn failure riding the
// io_err union and a child ended without a status code answering -1.
// `exit(code)` ends the process with a deliberate status — the proc
// capability's own op row, so a host refusing the capability refuses
// the spelling. The engine prints nothing and decides no exit code (the
// installing host owns what the status means), the call never answers,
// and the return is `never`, `panic`'s own shape.
/// The process's staged arguments as strings.
pub extern fn args () -> list[string]
/// One environment variable's value, none when unset.
pub extern fn env (name: string) -> string | none
/// Runs a child to completion over the argument list, answering
/// its exit status (-1 without one).
pub extern fn proc_run (cmd: string, args: list[string]) -> int | io_err
/// Ends the process with the status; never answers.
pub extern fn exit (code: int) -> never
/// Connects to the host and port, answering the linear
/// connection handle; a failed connect halts.
pub extern fn net_connect (host: string, port: int) -> net_handle
/// Sends the text over the connection, or its net failure.
pub extern fn net_send (conn: int, data: string) -> () | net_err
/// Reads up to the byte count from the connection, or its net
/// failure.
pub extern fn net_recv (conn: int, max_bytes: int) -> string | net_err
/// Closes the connection id, idempotently.
pub extern fn net_close (conn: int) -> ()
/// Fetches the URL over HTTP, answering the body text; a failure
/// halts.
pub extern fn http_get (url: string) -> string
// The json face (`json`, `parse_json`, `to_json`, the typed readers)
// is the @std package's own member, std/json.ds beside this core.
/// Aborts the enclosing nursery scope with the error value; the
/// scope's block answers it.
pub extern fn cancel[t] (e: t) -> ()
// The extraction family: calls type locally against the checked
// receiver (unwrap_or's fallback is eager, unwrap_or_else's lambda runs
// only on the none side), composed with `?` for early exits.
/// The optional's value or the eager fallback.
pub extern fn unwrap_or[t] (x: t?, y: t) -> t
/// The optional's value, or the fallback lambda's answer on the
/// none side.
pub extern fn unwrap_or_else[t] (x: t?, f: fn() -> t) -> t
/// The optional's value or the given error, as a union.
pub extern fn ok_or[t, e] (x: t?, err: e) -> t | e
/// Maps the failure side of a union through the lambda.
pub extern fn map_err[t, e, e2] (x: t | e, f: fn(e) -> e2) -> t | e2

// The file face's ds-source handlers over the raw externs: the
// package-owned `file_handle` type never reaches a native call directly —
// the handlers read the fd word out and pass the raw seam an int,
// the value staying owned by its binding (the deinit closes what an
// explicit `close_file` already closed, idempotently). The read's
// failure rides the io_err union out to the caller, so `?`, the
// `.ok`/`.err` handlers, is-narrowing, and match all extract it; the
// total spelling stays `open_file`'s alone, since `file_handle` is
// deinit-carrying and a union member that declares a deinit refuses.
/// Reads up to n bytes from the file, or its io failure.
pub fn read_exact (f: file_handle, n: int) -> bytes | io_err {
  const b = read_raw(f.fd, n)
  b
}
/// Closes the file; the deinit closes what it already closed.
pub fn close_file (f: file_handle) -> () {
  close_raw(f.fd)
}

// The net face's ds-source handlers over the raw externs: the same
// discipline as the file handlers — the package-owned `net_handle`
// type never reaches a native call directly, the handlers read the id
// word out and pass the raw seams an int, the value staying owned by
// its binding (the deinit closes what an explicit `close_conn` already
// closed, idempotently). The fallible reads answer the failure
// taxonomy's union — the natives' one failure discriminant per class
// lands on the `net_err` case the error class names (the error-class
// mapping), so `?`, the `.err` handler, is-narrowing, and match extract
// a real enum case — and they bind their answer before returning it: a
// trailing call would sit in tail position and a tail call to a
// fallible native refuses. `net_connect` keeps the total spelling for
// `open_file`'s own reason: the handle is deinit-carrying, so a union
// member holding it refuses.
/// Sends the text over the connection, or its net failure.
pub fn send (h: net_handle, data: string) -> () | net_err {
  const sent = net_send(h.conn, data)
  sent
}
/// Reads up to the byte count from the connection, or its net
/// failure.
pub fn recv (h: net_handle, max_bytes: int) -> string | net_err {
  const reply = net_recv(h.conn, max_bytes)
  reply
}
/// Closes the connection; the deinit closes what it already
/// closed.
pub fn close_conn (h: net_handle) -> () {
  net_close(h.conn)
}



// The net face's server half: the same
// discipline as the connection half over the package-owned linear
// `net_listener`, whose one inline word is the listener table's key.
// `net_listen` answers this type directly — the total spelling for
// `net_connect`'s own reason (the handle is deinit-carrying, so a union
// member holding it refuses), so a failed bind prints the net error
// line and halts — and `accept` is a ds-source handler over the raw
// `net_accept` extern, reading the id word out the way `send`/`recv`
// do (a native call cannot borrow a deinit-carrying argument) and
// answering the connection half's own `net_handle`: the accepted
// connection registers like a connecting one, so it owns that face in
// full. `accept` keeps the total spelling for the same reason, so a
// failed accept (the configured wait's bound expiring with no pending
// connection among its classes) halts on the net error line too; a
// non-halting accept needs a union member holding a deinit-carrying
// handle, which the checker refuses (an open author question). The deinit
// closes the listener (a binding dropped without an explicit
// close_listener still ends clean), and `net_listener_close` is
// idempotent because the deinit may fire on a handle the owner already
// closed. `local_addr` answers the bound address, the port-0 bind's
// report (the face's one address op, total over the live handle).
/// The server's linear listener handle; the deinit closes it.
pub struct net_listener: ~Copyable {
  lid: int
  deinit { net_listener_close(self.lid) }
}
/// Binds the host and port, answering the listener; a failed
/// bind halts.
pub extern fn net_listen (host: string, port: int) -> net_listener
/// Accepts one connection over the listener id, answering its
/// handle; a failed accept halts.
pub extern fn net_accept (lid: int) -> net_handle
/// Closes the listener id, idempotently.
pub extern fn net_listener_close (lid: int) -> ()
/// The listener's bound local address, "host:port".
pub extern fn net_local_addr (lid: int) -> string
// The server half's tls upgrade (the tls capability's own op): the
// accepted connection upgraded over the
// host-pinned rustls server identity, registering with its session so
// it owns the same `net_handle` face in full — the send/recv over the
// tls records, the closing deinit the plain accepted connection's
// own. The host pins the identity (no default exists, a server
// certificate being the host's own), the unprovisioned call answering
// its own net_err; the tls-omitting host keeps the op unserved. The
// total spelling `accept` keeps is this op's too (the handle is
// deinit-carrying, so a union member holding it refuses), so a failed
// accept or handshake halts on the net error line; a non-halting
// upgrade needs the same optional-over-linear union seam.
/// Accepts one connection and upgrades it over TLS; a failed
/// accept or handshake halts.
pub extern fn net_accept_tls (lid: int) -> net_handle
/// Accepts one connection over the listener, answering its
/// handle; a failed accept halts.
pub fn accept (l: net_listener) -> net_handle {
  const conn = net_accept(l.lid)
  conn
}
/// Closes the listener; the deinit closes what it already
/// closed.
pub fn close_listener (l: net_listener) -> () {
  net_listener_close(l.lid)
}
// The listener's one address op: the bound local address rendered
// "host:port", the port-0 bind's report (a port-0 listener is the one
// way a source hands its bound port back). Total like the close seam —
// the member never reaches a dead binding (the handle's linearity owns
// that), the raw seam's unknown-handle answer the inert empty string.
/// The listener's bound local address, "host:port" — the
/// port-0 bind's report.
pub fn local_addr (l: net_listener) -> string {
  const addr = net_local_addr(l.lid)
  addr
}
// The listener's tls upgrade: the raw seam's id word out the same way
// `accept` reads it, answering the upgraded connection's own
// `net_handle` — the total spelling the raw extern keeps, a failed
// accept or handshake halting on the net error line.
/// Accepts and upgrades one connection over the listener; a
/// failed accept or handshake halts.
pub fn accept_tls (l: net_listener) -> net_handle {
  const conn = net_accept_tls(l.lid)
  conn
}

// The process face's capture half: the same discipline as the other
// handle faces over the package-owned linear `proc_handle`, whose one
// inline word is the process table's key. `proc_spawn` answers this
// type directly — the total spelling for the same reason every
// deinit-carrying handle keeps it (a union member holding one
// refuses), so a failed spawn prints the io error line and halts —
// and the child's standard input, output, and error ride pipes, so
// `write` hands the child input (the pipe staying open across calls
// until `close_in` ends it) while `read_out` takes its captured
// output and `read_err` its captured diagnostics, one read of at most
// the requested bytes each, the empty string the pipe's orderly end.
// `close_in` is the stdin-close seam — the child's end-of-input while
// the handle stays live, total and idempotent like the close it
// narrows. `wait` answers the child's exit status (a child ended
// without a status code answering -1, `proc_run`'s convention) and
// answers it idempotently, `try_wait` the non-blocking poll over the
// same reaped word (the none member while the child runs), and the
// deinit closes the handle: a still-running child is killed and
// reaped, so a dropped binding never leaks a child, and `proc_close`
// is idempotent because the deinit may fire on a handle the owner
// already closed. The blocking rows block the calling fiber like
// `proc_run`'s own wait. The handlers read the id word out the way
// `send`/`recv` do (a native call cannot borrow a deinit-carrying
// argument), and the fallible rows answer the io_err union, binding
// their answer before returning it the same way (a tail call to a
// fallible native refuses).
/// The piped child's linear handle; the deinit kills and reaps
/// a still-running child.
pub struct proc_handle: ~Copyable {
  id: int
  deinit { proc_close(self.id) }
}
/// Spawns the child over the argument list with piped streams,
/// answering its handle; a failed spawn halts.
pub extern fn proc_spawn (cmd: string, args: list[string]) -> proc_handle
/// Hands the child the text on its stdin, or the io failure.
pub extern fn proc_write (pid: int, data: string) -> () | io_err
/// Reads up to the byte count of the child's captured output,
/// or the io failure.
pub extern fn proc_read (pid: int, max_bytes: int) -> string | io_err
/// Blocks for the child's exit status (-1 without one),
/// answering idempotently.
pub extern fn proc_wait (pid: int) -> int | io_err
/// Closes the child handle: kills and reaps a still-running
/// child, idempotently.
pub extern fn proc_close (pid: int) -> ()
/// Closes the child's stdin, its end-of-input, idempotently.
pub extern fn proc_close_in (pid: int) -> ()
/// Reads up to the byte count of the child's captured
/// diagnostics, or the io failure.
pub extern fn proc_read_err (pid: int, max_bytes: int) -> string | io_err
/// The reaped exit status without blocking, none while the
/// child runs.
pub extern fn proc_try_wait (pid: int) -> int | none
/// Hands the child the text on its stdin, or the io failure.
pub fn write (p: proc_handle, data: string) -> () | io_err {
  const sent = proc_write(p.id, data)
  sent
}
/// Reads up to the byte count of the child's captured output,
/// or the io failure.
pub fn read_out (p: proc_handle, max_bytes: int) -> string | io_err {
  const captured = proc_read(p.id, max_bytes)
  captured
}
/// Blocks for the child's exit status (-1 without one),
/// answering idempotently.
pub fn wait (p: proc_handle) -> int | io_err {
  const status = proc_wait(p.id)
  status
}
/// Closes the child's stdin, its end-of-input.
pub fn close_in (p: proc_handle) -> () {
  proc_close_in(p.id)
}
/// Reads up to the byte count of the child's captured
/// diagnostics, or the io failure.
pub fn read_err (p: proc_handle, max_bytes: int) -> string | io_err {
  const complaint = proc_read_err(p.id, max_bytes)
  complaint
}
/// The child's exit status without blocking, none while it
/// runs.
pub fn try_wait (p: proc_handle) -> int | none {
  const status = proc_try_wait(p.id)
  status
}
