// The stdlib ambient: the checked-declaration layer of the stdlib (the
// runtime half is the ds-vm builtin core plus the platform handler the
// host installs behind the platform declaration below). Registered as a package member
// before the user's sources; the package namespace is two [G3, F9] —
// types and values — so `struct map` and `fn map` coexist, and a name may
// be redeclared by a corpus file only in the other namespace. The
// fallible natives' failure taxonomy is ambient-owned (io_err, net_err,
// parse_err — the runtime discriminants the platform natives answer), so
// the five fallible reads return real success unions. Still file-owned:
// file, url, raw_fd, json, and the stack API — `open`/`read_exact`
// stay absent because their signatures cannot name the caller's `file`.

// The default platform (H5, E1): the `ds` CLI is this platform's
// provider, and the checker verifies the package's world usage stays
// inside what it provides.
platform "std" provides <console, fsys, net, time>

trait Copyable { }

// The show derive's target (G1, F6): one member answering the
// construction spelling; `#[derive(show)]` synthesizes the impl.
trait show {
  fn show(self) -> string
}
// The primitives carry show themselves, so a generic derive
// instantiates at them and an explicit `.show()` answers anywhere.
impl show for int {
  fn show(self) -> string { str(self) }
}
impl show for float {
  fn show(self) -> string { str(self) }
}
impl show for bool {
  fn show(self) -> string { str(self) }
}
impl show for byte {
  fn show(self) -> string { str(self) }
}
impl show for char {
  fn show(self) -> string { "$self" }
}
impl show for string {
  fn show(self) -> string { "$self" }
}

// The ord derive's target (G1, B9's ruling that ordering is never
// structural): one member answering the field-order lexicographic
// comparison; `#[derive(ord)]` synthesizes the impl. The primitives
// carry ord themselves, each part's sort key an explicit compare
// native: float through `total_compare` (the IEEE total order, the one
// total comparison the trapping `<`/`>` cannot spell), and string,
// char, and byte through their own compare natives (the UTF-8 byte
// order, the Unicode scalar order, and the u8 order).
trait ord {
  fn compare(self, other: Self) -> int
}
impl ord for int {
  fn compare(self, other: Self) -> int {
    if self < other { -1 } else if self > other { 1 } else { 0 }
  }
}
impl ord for bool {
  fn compare(self, other: Self) -> int {
    if self { if other { 0 } else { 1 } } else { if other { -1 } else { 0 } }
  }
}
impl ord for float {
  fn compare(self, other: Self) -> int { total_compare(self, other) }
}
impl ord for string {
  fn compare(self, other: Self) -> int { str_compare(self, other) }
}
impl ord for char {
  fn compare(self, other: Self) -> int { char_compare(self, other) }
}
impl ord for byte {
  fn compare(self, other: Self) -> int { byte_compare(self, other) }
}

// The hash derive's target (G1, B9's ruling that hash stays consistent
// with universal structural `==`): one member answering the content
// hash; `#[derive(hash)]` synthesizes the impl. Every primitive part
// carries hash itself: int and bool mix their own word, byte through
// its decimal text (the atom sits outside the int conversion family),
// string and char through the FNV-1a native over their bytes, and
// float through the fold native (which normalizes -0.0 to +0.0 and
// every NaN payload to the one canonical NaN, the bit-structural
// equality B9 pins).
trait hash {
  fn hash(self) -> int
}
impl hash for int {
  fn hash(self) -> int { self }
}
impl hash for bool {
  fn hash(self) -> int { if self { 1 } else { 0 } }
}
impl hash for float {
  fn hash(self) -> int { float_hash(self) }
}
impl hash for string {
  fn hash(self) -> int { str_hash(self) }
}
impl hash for char {
  fn hash(self) -> int { char_hash(self) }
}
impl hash for byte {
  fn hash(self) -> int { str_hash(str(self)) }
}

// The clone derive's target (G1): one member answering the shallow
// duplicate; `#[derive(clone)]` synthesizes the impl. The primitives
// carry clone themselves (the one-word atom answers itself, byte's
// included), so the derived body is a construction over the borrowed
// receiver whose Ref parts dup through the placement pass — a count
// bump per reference, never a deep copy (C4).
trait clone {
  fn clone(self) -> Self
}
impl clone for int {
  fn clone(self) -> Self { self }
}
impl clone for bool {
  fn clone(self) -> Self { self }
}
impl clone for float {
  fn clone(self) -> Self { self }
}
impl clone for string {
  fn clone(self) -> Self { self }
}
impl clone for char {
  fn clone(self) -> Self { self }
}
impl clone for byte {
  fn clone(self) -> Self { self }
}

tag int
tag float
tag bool
tag string
tag char
// The b'x' literal's atom [F6]: its own u8 width class, outside
// the int conversion family.
tag byte
tag bytes
tag u32

struct list[t]
struct map[k, v]

// The failure taxonomy of the fallible natives: the platform tags the
// runtime discriminants answer (io_err for the file surface, parse_err
// for the pure readers). net_err keeps the record's own two-case shape.
tag io_err
tag parse_err
enum net_err {
  timeout
  refused
}

// A text row: keyed lookup over strings (get feeds the first parameter).
type row = map[string, string]

// The config the readers answer and the fallback rebuilds (the optional
// port is the tutorial's b14 extraction shape; an int constructs in).
struct config { host: string, port: int?, retries: int }

// The fetch result; body extraction is consume.
struct response

// The nursery demo's fixed page list.
const urls = ["https://ds.dev", "https://example.org"]

extern fn get[k, v] (m: map[k, v], key: k) -> v | none
extern fn map[t, r] (xs: list[t], f: fn(t) -> r) -> list[r]
extern fn cons[t] (x: t, xs: list[t]) -> list[t]
extern fn head[t] (xs: list[t]) -> t?
extern fn tail[t] (xs: list[t]) -> list[t]
extern fn list_new[t] () -> list[t]
extern fn list_len[t] (xs: list[t]) -> int
extern fn list_get[t] (xs: list[t], i: int) -> t | none
extern fn list_concat[t] (a: list[t], b: list[t]) -> list[t]
extern fn list_push[t] (xs: mut list[t], x: t) -> ()
extern fn map_new[k, v] () -> map[k, v]
extern fn map_set[k, v] (m: mut map[k, v], key: k, value: v) -> ()
extern fn map_get[k, v] (m: map[k, v], key: k) -> v | none
extern fn map_len[k, v] (m: map[k, v]) -> int
extern fn join (parts: list[string], sep: string) -> string
extern fn len[t] (xs: t) -> int
extern fn trim (s: string) -> string
extern fn parse_int (s: string) -> int | parse_err
extern fn split (s: string, sep: char) -> list[string]
extern fn substring (s: string, start: int, end: int) -> string
extern fn concat (a: string, b: string) -> string
extern fn to_upper (s: string) -> string
extern fn to_lower (s: string) -> string
extern fn char_at (s: string, i: int) -> string
extern fn collect[t] (xs: list[t]) -> list[t]
extern fn first[t] (xs: list[t]) -> t?
extern fn filter[t] (xs: list[t], f: fn(t) -> bool) -> list[t]
extern fn partition[t] (xs: list[t], f: fn(t) -> bool) -> (list[t], list[t])
extern fn reduce[t] (xs: list[t], init: t, f: fn(t, t) -> t) -> t
extern fn str[t] (v: t) -> string
extern fn total_compare (a: float, b: float) -> int
extern fn str_compare (a: string, b: string) -> int
extern fn char_compare (a: char, b: char) -> int
extern fn byte_compare (a: byte, b: byte) -> int
extern fn str_hash (s: string) -> int
extern fn float_hash (f: float) -> int
extern fn char_hash (c: char) -> int
extern fn println (msg: string) -> ()
extern fn print (msg: string) -> ()
extern fn log (msg: string) -> ()
extern fn close (fd: int) -> ()
extern fn to_u32_le (b: bytes) -> u32
extern fn read_file (path: string) -> string | io_err
extern fn write_file (path: string, contents: string) -> ()
extern fn file_exists (path: string) -> bool
extern fn fs_list (dir: string) -> list[string]
extern fn file_size (path: string) -> int
extern fn net_connect (host: string, port: int) -> int
extern fn net_send (conn: int, data: string) -> ()
extern fn net_recv (conn: int, max_bytes: int) -> string
extern fn net_close (conn: int) -> ()
extern fn http_get (url: string) -> string
extern fn parse_json (text: string) -> string
extern fn load_rows (path: string) -> list[row] | io_err
extern fn read_config (path: string) -> config | io_err
extern fn default_config () -> config
extern fn fetch (u: string) -> response | net_err
extern fn consume (r: response) -> string
extern fn cancel[t] (e: t) -> ()
extern fn par_map[t, r] (xs: list[t], f: fn(t) -> r) -> list[r]
extern fn par_reduce[t] (xs: list[t], init: t, f: fn(t, t) -> t) -> t
// The E4 extraction family: calls type locally against the checked
// receiver (unwrap_or's fallback is eager, unwrap_or_else's lambda runs
// only on the none side), composed with `?` for early exits.
extern fn unwrap_or[t] (x: t?, y: t) -> t
extern fn unwrap_or_else[t] (x: t?, f: fn() -> t) -> t
extern fn ok_or[t, e] (x: t?, err: e) -> t | e
extern fn map_err[t, e, e2] (x: t | e, f: fn(e) -> e2) -> t | e2
extern fn die[t] (msg: string) -> t
extern fn max[t] (a: t, b: t) -> t
