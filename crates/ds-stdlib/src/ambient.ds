// The stdlib ambient: the checked-declaration layer of the M3 stdlib (the
// runtime half is two native modules — the ds-vm builtin core, and the
// std platform natives the host installs). Registered as a package member
// before the user's sources; the package namespace is two [G3, F9] —
// types and values — so `struct map` and `fn map` coexist, and a name may
// be redeclared by a corpus file only in the other namespace. Per-file
// types (config, io_err, file, url, net_err, ord, json, the stack API)
// stay file-owned: failure sets ride the `error` effect row
// (declared_rows), never a file-owned union.

trait Copyable { }

tag int
tag float
tag bool
tag string
tag char
tag bytes
tag u32

struct list[t]
struct map[k, v]

// A text row: keyed lookup over strings (get feeds the first parameter).
type row = map[string, string]

// The fetch result; body extraction is consume.
struct response

extern fn get[k, v] (m: map[k, v], key: k) -> v | none
extern fn map[t, r] (xs: list[t], f: fn(t) -> r) -> list[r]
extern fn cons[t] (x: t, xs: list[t]) -> list[t]
extern fn head[t] (xs: list[t]) -> t?
extern fn tail[t] (xs: list[t]) -> list[t]
extern fn list_new[t] () -> list[t]
extern fn list_len[t] (xs: list[t]) -> int
extern fn list_get[t] (xs: list[t], i: int) -> t | none
extern fn list_concat[t] (a: list[t], b: list[t]) -> list[t]
extern fn list_push[t] (xs: mut list[t], x: t) -> ()
extern fn join (parts: list[string], sep: string) -> string
extern fn len[t] (xs: t) -> int
extern fn trim (s: string) -> string
extern fn parse_int (s: string) -> int
extern fn split (s: string, sep: char) -> list[string]
extern fn substring (s: string, start: int, end: int) -> string
extern fn concat (a: string, b: string) -> string
extern fn to_upper (s: string) -> string
extern fn to_lower (s: string) -> string
extern fn char_at (s: string, i: int) -> string
extern fn collect[t] (xs: list[t]) -> list[t]
extern fn first[t] (xs: list[t]) -> t?
extern fn filter[t] (xs: list[t], f: fn(t) -> bool) -> list[t]
extern fn partition[t] (xs: list[t], f: fn(t) -> bool) -> (list[t], list[t])
extern fn reduce[t] (xs: list[t], init: t, f: fn(t, t) -> t) -> t
extern fn str[t] (v: t) -> string
extern fn println (msg: string) -> ()
extern fn print (msg: string) -> ()
extern fn log (msg: string) -> ()
extern fn close (fd: int) -> ()
extern fn to_u32_le (b: bytes) -> u32
extern fn read_file (path: string) -> string
extern fn write_file (path: string, contents: string) -> ()
extern fn file_exists (path: string) -> bool
extern fn fs_list (dir: string) -> list[string]
extern fn file_size (path: string) -> int
extern fn net_connect (host: string, port: int) -> int
extern fn net_send (conn: int, data: string) -> ()
extern fn net_recv (conn: int, max_bytes: int) -> string
extern fn net_close (conn: int) -> ()
extern fn http_get (url: string) -> string
extern fn parse_json (text: string) -> string
extern fn load_rows (path: string) -> list[row]
extern fn fetch (u: string) -> response
extern fn consume (r: response) -> string
extern fn cancel[t] (e: t) -> ()
extern fn par_map[t, r] (xs: list[t], f: fn(t) -> r) -> list[r]
extern fn par_reduce[t] (xs: list[t], init: t, f: fn(t, t) -> t) -> t
extern fn die[t] (msg: string) -> t
extern fn max[t] (a: t, b: t) -> t
