// The @std json face (the serialization substrate's interim step): the
// typed value family over the JSON grammar
// with its own parser, serializer, and the typed readers and writers
// the from_json/to_json walks consume — the same ds source that lived
// at the ambient core's tail, now the reserved package's own member.
// Every undeclaring registration composes this file back after the
// core (the merged reading), and an entry script session over the
// implicit @std graph composes it back too (the bare spellings staying
// load-bearing while the migration runs), so both readings stay
// namespace-identical with the pre-migration ambient; a package
// compile declaring the dep binds these names through the linked
// surface alone. The collection seams stay the ambient core's own
// private externs at their pinned positions, and the @std bundle
// composes this file into its core member so the face's free seam
// calls stay same-file there too; the object walk iterates keys
// through the `keys` member.

// ---- the json face (the `json` enum's own parser and serializer) ----
// Ordinary ds source over the string block's primitives: the walk reads
// the text one char at a time (`char_at`, its checked read narrowing to
// the char at every guarded position), classifies by compare, and
// constructs through the enum's own cases, so the compiler knows no json
// name — the face is this package's. The recursion threads (value, next
// position) tuples, refusing parse_err at the first grammar violation,
// with a depth budget keeping a hostile document off the interpreter
// stack (every recursion carries its depth and a past-budget document
// answers parse_err, never a stack trap).

// One parsed member with the position past it — a struct, because a
// tuple over the `json` union distributes member-wise and no single
// tuple type remains to destructure.
struct json_step { value: json, next: int }

// The string reader's own step (the same shape over one string).
struct str_step { value: string, next: int }

fn is_ws (c: char | none) -> bool {
  if c is char {
    c == ' ' || c == '\t' || c == '\n' || c == '\r'
  } else {
    false
  }
}

// The insignificant-whitespace skip, answering the next position.
fn json_ws (text: string, at: int) -> int {
  const c = char_at(text, at)
  if at < len(text) && c is char && is_ws(c) { json_ws(text, at + 1) } else { at }
}

fn is_digit (c: char | none) -> bool {
  if c is char {
    char_compare(c, '0') >= 0 && char_compare(c, '9') <= 0
  } else {
    false
  }
}

fn has_dot_or_exp (s: string) -> bool {
  var i = 0
  var found = false
  while i < len(s) {
    const c = char_at(s, i)
    if c is char {
      if c == '.' || c == 'e' || c == 'E' { found = true }
    }
    i += 1
  }
  found
}

fn hex_digit (c: char | none) -> int | none {
  var i = 0
  while i < 16 && char_at("0123456789abcdef", i) != c { i += 1 }
  if i < 16 { i } else { none }
}

fn hex4 (text: string, at: int) -> int | parse_err {
  if at + 4 > len(text) { return parse_err(pos: at) }
  const a = hex_digit(char_at(text, at))
  if a is none { return parse_err(pos: at) }
  const b = hex_digit(char_at(text, at + 1))
  if b is none { return parse_err(pos: at + 1) }
  const c = hex_digit(char_at(text, at + 2))
  if c is none { return parse_err(pos: at + 2) }
  const e = hex_digit(char_at(text, at + 3))
  if e is none { return parse_err(pos: at + 3) }
  a * 4096 + b * 256 + c * 16 + e
}

fn simple_escape (e: char) -> string | none {
  if e == '"' { "\"" }
  else if e == '\\' { "\\" }
  else if e == '/' { "/" }
  else if e == 'b' { "\u{8}" }
  else if e == 'f' { "\u{c}" }
  else if e == 'n' { "\n" }
  else if e == 'r' { "\r" }
  else if e == 't' { "\t" }
  else { none }
}

// One \u escape starting at `at` (the first hex digit): the four hex
// digits name a codepoint, a high surrogate must be followed by its low
// one (the pair folding into the scalar it names), and a lone low
// surrogate refuses. Answers the decoded string and the position after
// the escape.
fn json_unicode (text: string, at: int) -> str_step | parse_err {
  const high = hex4(text, at)?
  if high >= 0xd800 && high <= 0xdbff {
    if char_at(text, at + 4).unwrap_or('\0') == '\\' && char_at(text, at + 5).unwrap_or('\0') == 'u' {
      const low = hex4(text, at + 6)?
      if low >= 0xdc00 && low <= 0xdfff {
        const code = 65536 + (high - 0xd800) * 1024 + low - 0xdc00
        const c = char_of(code).ok_or(parse_err(pos: at))?
        str_step { value: "$c", next: at + 10 }
      } else { parse_err(pos: at + 6) }
    } else { parse_err(pos: at + 4) }
  } else if high >= 0xdc00 && high <= 0xdfff {
    parse_err(pos: at)
  } else {
    const c = char_of(high).ok_or(parse_err(pos: at))?
    str_step { value: "$c", next: at + 4 }
  }
}

// The empty-separator fold the json face builds its strings with:
// `join`'s separator is one char, so the parts concatenate per element
// here.
fn join_empty (parts: list[string]) -> string {
  var out = ""
  var i = 0
  while i < list_len(parts) {
    out = out + list_get(parts, i).unwrap_or("")
    i += 1
  }
  out
}

// One string's content, `at` past the opening quote: raw runs push
// verbatim, the eight simple escapes and \u (surrogate pairs included)
// decode, and a raw control character inside the content refuses (the
// grammar's rule — the escaped spellings carry them). Answers the
// decoded string and the position past the closing quote.
fn json_string_body (text: string, at: int) -> str_step | parse_err {
  var parts = list[string]()
  var i = at
  var start = at
  while i < len(text) {
    const c = char_at(text, i)
    if c is none { return parse_err(pos: i) }
    if c == '"' {
      if i > start { list_push(parts, substring(text, start, i).unwrap_or("")) }
      return str_step { value: join_empty(parts), next: i + 1 }
    } else if c == '\\' {
      const e = char_at(text, i + 1)
      if i > start { list_push(parts, substring(text, start, i).unwrap_or("")) }
      if e is none { return parse_err(pos: i + 1) }
      if e == 'u' {
        const step = json_unicode(text, i + 2)
        if step is parse_err { return step }
        list_push(parts, step.value)
        i = step.next
        start = i
      } else {
        const d = simple_escape(e)
        if d is none { return parse_err(pos: i + 1) }
        list_push(parts, d)
        i = i + 2
        start = i
      }
    } else if char_compare(c, ' ') < 0 {
      return parse_err(pos: i)
    } else {
      i += 1
    }
  }
  parse_err(pos: len(text))
}

// The end of one number token per the JSON grammar, or `at` itself when
// the token is not a number (`-` alone, a bare `1.`, an exponent with
// no digits — a leading-zero prefix leaves trailing content the
// caller's own trailing-content refusal then reports).
fn json_number_end (text: string, at: int) -> int {
  var i = at
  if i < len(text) && char_at(text, i).unwrap_or('\0') == '-' { i += 1 }
  if i >= len(text) || !is_digit(char_at(text, i)) { return at }
  if char_at(text, i).unwrap_or('\0') == '0' {
    i += 1
  } else {
    while i < len(text) && is_digit(char_at(text, i)) { i += 1 }
  }
  if i < len(text) && char_at(text, i).unwrap_or('\0') == '.' {
    i += 1
    if i >= len(text) || !is_digit(char_at(text, i)) { return at }
    while i < len(text) && is_digit(char_at(text, i)) { i += 1 }
  }
  if i < len(text) && (char_at(text, i).unwrap_or('\0') == 'e' || char_at(text, i).unwrap_or('\0') == 'E') {
    i += 1
    if i < len(text) && (char_at(text, i).unwrap_or('\0') == '+' || char_at(text, i).unwrap_or('\0') == '-') { i += 1 }
    if i >= len(text) || !is_digit(char_at(text, i)) { return at }
    while i < len(text) && is_digit(char_at(text, i)) { i += 1 }
  }
  i
}

// The number token's typed case: an in-range integer literal answers
// json_int (int kept faithful), everything else — a decimal point, an
// exponent, or an integer literal past the int range — answers json_float
// through the correctly-rounded reader.
fn json_number (text: string, at: int) -> json_step | parse_err {
  const end = json_number_end(text, at)
  if end == at { return parse_err(pos: at) }
  const token = substring(text, at, end).unwrap_or("")
  if has_dot_or_exp(token) {
    const f = map_err(parse_float(token), (e: parse_err) => parse_err(pos: at + e.pos))?
    json_step { value: json_float(value: f), next: end }
  } else {
    match parse_int(token) {
      parse_err => {
        const f = map_err(parse_float(token), (e: parse_err) => parse_err(pos: at + e.pos))?
        json_step { value: json_float(value: f), next: end }
      }
      n => json_step { value: json_int(value: n), next: end }
    }
  }
}

// One literal word (`true`, `false`, `null`), answering the position
// past it.
fn json_word (text: string, at: int, lit: string, v: json) -> json_step | parse_err {
  if substring(text, at, at + len(lit)).unwrap_or("") == lit { json_step { value: v, next: at + len(lit) } } else { parse_err(pos: at) }
}

fn json_array_body (text: string, at: int, depth: int) -> json_step | parse_err {
  var items = list[json]()
  var i = json_ws(text, at)
  var done = false
  if i < len(text) && char_at(text, i).unwrap_or('\0') == ']' {
    done = true
    i = i + 1
  }
  while !done {
    const step = json_value(text, i, depth)
    if step is parse_err { return step }
    list_push(items, step.value)
    const after = json_ws(text, step.next)
    if after >= len(text) { return parse_err(pos: after) }
    const c = char_at(text, after)
    if c is none { return parse_err(pos: after) }
    if c == ']' {
      done = true
      i = after + 1
    } else if c == ',' {
      i = json_ws(text, after + 1)
    } else { return parse_err(pos: after) }
  }
  json_step { value: json_array(items: items), next: i }
}

fn json_object_body (text: string, at: int, depth: int) -> json_step | parse_err {
  var fields = map[string, json]()
  var i = json_ws(text, at)
  var done = false
  if i < len(text) && char_at(text, i).unwrap_or('\0') == '}' {
    done = true
    i = i + 1
  }
  while !done {
    if i >= len(text) || char_at(text, i).unwrap_or('\0') != '"' { return parse_err(pos: i) }
    const key = json_string_body(text, i + 1)
    if key is parse_err { return key }
    const colon = json_ws(text, key.next)
    if colon >= len(text) || char_at(text, colon).unwrap_or('\0') != ':' { return parse_err(pos: colon) }
    const step = json_value(text, colon + 1, depth)
    if step is parse_err { return step }
    map_set(fields, key.value, step.value)
    const after = json_ws(text, step.next)
    if after >= len(text) { return parse_err(pos: after) }
    const c = char_at(text, after)
    if c is none { return parse_err(pos: after) }
    if c == '}' {
      done = true
      i = after + 1
    } else if c == ',' {
      i = json_ws(text, after + 1)
    } else { return parse_err(pos: after) }
  }
  json_step { value: json_object(fields: fields), next: i }
}

fn json_value (text: string, at: int, depth: int) -> json_step | parse_err {
  if depth > 256 { return parse_err(pos: at) }
  const i = json_ws(text, at)
  if i >= len(text) { return parse_err(pos: i) }
  const c = char_at(text, i)
  if c is none { return parse_err(pos: i) }
  if c == '{' { json_object_body(text, i + 1, depth + 1) }
  else if c == '[' { json_array_body(text, i + 1, depth + 1) }
  else if c == '"' {
    const s = json_string_body(text, i + 1)
    if s is parse_err { return s }
    json_step { value: json_string(value: s.value), next: s.next }
  }
  else if c == 't' { json_word(text, i, "true", json_bool(value: true)) }
  else if c == 'f' { json_word(text, i, "false", json_bool(value: false)) }
  else if c == 'n' { json_word(text, i, "null", json_null) }
  else if c == '-' || is_digit(c) {
    const step = json_number(text, i)
    step
  }
  else { parse_err(pos: i) }
}

// The JSON reader: one document answering its typed value, invalid text
// answering parse_err carrying the offset the parse gave up at.
pub fn parse_json (text: string) -> json | parse_err {
  const step = json_value(text, 0, 0)
  if step is parse_err { return step }
  const rest = json_ws(text, step.next)
  if rest == len(text) { step.value } else { parse_err(pos: rest) }
}

// The serializer's string escaping: a raw run between the specials, the
// two escaped specials, and control characters as their \u00XX spellings
// (a scalar the JSON grammar cannot carry raw).
fn to_json_string (s: string, acc: list[string]) -> list[string] {
  var a = acc
  var i = 0
  var start = 0
  while i < len(s) {
    const c = char_at(s, i).unwrap_or('\0')
    if c == '"' || c == '\\' {
      if i > start { list_push(a, substring(s, start, i).unwrap_or("")) }
      if c == '"' {
        list_push(a, "\\\"")
      } else {
        list_push(a, "\\\\")
      }
      i += 1
      start = i
    } else if char_compare(c, ' ') < 0 {
      if i > start { list_push(a, substring(s, start, i).unwrap_or("")) }
      const code = code_of(c)
      list_push(a, "\\u00" + substring("0123456789abcdef", code / 16, code / 16 + 1).unwrap_or("") + substring("0123456789abcdef", code % 16, code % 16 + 1).unwrap_or(""))
      i += 1
      start = i
    } else {
      i += 1
    }
  }
  if start < len(s) { list_push(a, substring(s, start, len(s)).unwrap_or("")) }
  list_push(a, "\"")
  a
}

// The serializer's array walk, one element per step over the accumulator
// (a linear value: each step consumes it and answers it back).
fn to_json_array (items: list[json], at: int, acc: list[string]) -> list[string] {
  if at >= list_len(items) {
    var close = acc
    list_push(close, "]")
    close
  } else {
    var a = acc
    if at > 0 { list_push(a, ",") }
    const elem = list_get(items, at).unwrap_or(json_null)
    to_json_array(items, at + 1, to_json_parts(elem, a))
  }
}

fn to_json_object (keys: list[string], at: int, fields: map[string, json], acc: list[string]) -> list[string] {
  if at >= list_len(keys) {
    var close = acc
    list_push(close, "}")
    close
  } else {
    var a = acc
    if at > 0 { list_push(a, ",") }
    const k = list_get(keys, at).unwrap_or("")
    var key = a
    list_push(key, "\"")
    key = to_json_string(k, key)
    list_push(key, ":")
    const v = map_get(fields, k).unwrap_or(json_null)
    to_json_object(keys, at + 1, fields, to_json_parts(v, key))
  }
}

fn to_json_parts (v: json, acc: list[string]) -> list[string] {
  var a = acc
  match v {
    json_null => {
      list_push(a, "null")
      a
    }
    json_bool { value } => {
      list_push(a, str(value))
      a
    }
    json_int { value } => {
      list_push(a, str(value))
      a
    }
    json_float { value } => {
      // a non-finite float has no JSON spelling, so it serializes as
      // null (the wider ecosystem's own convention); a finite one keeps
      // a float spelling (the reader's int-faithful split never narrows
      // back), appending ".0" to a Display form the grammar would read
      // back as an integer
      if value != value || value - value != 0.0 {
        list_push(a, "null")
      } else {
        const s = str(value)
        if has_dot_or_exp(s) {
          list_push(a, s)
        } else {
          list_push(a, s + ".0")
        }
      }
      a
    }
    json_string { value } => {
      list_push(a, "\"")
      to_json_string(value, a)
    }
    json_array { items } => {
      list_push(a, "[")
      to_json_array(items, 0, a)
    }
    json_object { fields } => {
      list_push(a, "{")
      to_json_object(fields.keys(), 0, fields, a)
    }
  }
}

// The JSON writer: one typed value answering its minified serialization.
pub fn to_json (v: json) -> string {
  join_empty(to_json_parts(v, list[string]()))
}

// ---- the json face's decode surface ----
// The typed readers a target's decode walks consume: one reader per
// case, a wrong shape answering parse_err (the face's own failure
// member), and the object member answering the optional so a walk
// none-tests the missing key into the same parse_err. The number
// split is kept here as the reader keeps it: json_as_int reads
// json_int alone and json_as_float reads json_float alone, the two
// never narrowing into each other. These are the per-field halves of
// the from_json walk; the target-typed construction itself is
// per-target (each target's members spell it over these readers).

// The object member by key, none over a missing key or a non-object.
pub fn json_member (v: json, key: string) -> json | none {
  match v {
    json_object { fields } => {
      const m = map_get(fields, key)
      m
    }
    _ => none
  }
}

pub fn json_as_int (v: json) -> int | parse_err {
  match v {
    json_int { value } => value
    _ => parse_err(pos: 0)
  }
}

pub fn json_as_float (v: json) -> float | parse_err {
  match v {
    json_float { value } => value
    _ => parse_err(pos: 0)
  }
}

pub fn json_as_bool (v: json) -> bool | parse_err {
  match v {
    json_bool { value } => value
    _ => parse_err(pos: 0)
  }
}

pub fn json_as_string (v: json) -> string | parse_err {
  match v {
    json_string { value } => value
    _ => parse_err(pos: 0)
  }
}

pub fn json_as_array (v: json) -> list[json] | parse_err {
  match v {
    json_array { items } => items
    _ => parse_err(pos: 0)
  }
}

pub fn json_as_object (v: json) -> map[string, json] | parse_err {
  match v {
    json_object { fields } => fields
    _ => parse_err(pos: 0)
  }
}

// The width-bridging readers: a json number reads as a byte
// (0-255) or a u32 through the checked bridge natives — an out-of-range
// number answers parse_err like a wrong shape — and a one-character json
// string reads as a char (any other length a wrong shape).
pub fn json_as_byte (v: json) -> byte | parse_err {
  match v {
    json_int { value } => {
      const b = byte_of(value)
      if b is none { parse_err(pos: 0) } else { b }
    }
    _ => parse_err(pos: 0)
  }
}

pub fn json_as_u32 (v: json) -> u32 | parse_err {
  match v {
    json_int { value } => {
      const u = u32_of(value)
      if u is none { parse_err(pos: 0) } else { u }
    }
    _ => parse_err(pos: 0)
  }
}

pub fn json_as_char (v: json) -> char | parse_err {
  match v {
    json_string { value } => {
      if len(value) == 1 {
        const c = char_at(value, 0)
        if c is none { parse_err(pos: 0) } else { c }
      } else { parse_err(pos: 0) }
    }
    _ => parse_err(pos: 0)
  }
}

// The bytes representation: a json array of numbers, one
// element per payload byte — the exact round-trip of the writer below,
// consistent with the show impl's byte-list rendering. Every element
// must be an in-range json number; anything else answers parse_err.
pub fn json_as_bytes (v: json) -> bytes | parse_err {
  const items = json_as_array(v)?
  var out = list[byte]()
  var i = 0
  while i < list_len(items) {
    const b = json_as_byte(list_get(items, i).unwrap_or(json_null))
    if b is parse_err { return b }
    list_push(out, b)
    i += 1
  }
  bytes_of(out)
}

// The encode half the to_json walk dispatches through:
// byte and u32 write as json numbers, char as its one-character json
// string, and bytes as the array of numbers the reader above takes
// back — one construction per value the case vocabulary alone cannot
// spell from these widths.
pub fn json_of_byte (b: byte) -> json { json_int(value: int_of_byte(b)) }

pub fn json_of_u32 (v: u32) -> json { json_int(value: int_of_u32(v)) }

pub fn json_of_char (c: char) -> json { json_string(value: "$c") }

pub fn json_of_bytes (b: bytes) -> json {
  var items = list[json]()
  for e in byte_list(b) {
    list_push(items, json_int(value: int_of_byte(e)))
  }
  json_array(items: items)
}


// ---- the json driver over the serialization face ----
// The json face is the driver face's first driver: the
// document type's empty-document seed (the encode walk's receiver) and
// the encoder/decoder impls delegating to this file's own readers and
// constructions above, so the derive synthesis targets the driver
// traits alone and a second format plugs in as its own package.
impl json {
  fn default() -> json { json_null }
}

impl decoder for json {
  fn dec_object (self) -> map[string, json] | parse_err { json_as_object(self) }
  fn dec_array (self) -> list[json] | parse_err { json_as_array(self) }
  fn dec_member (self, key: string) -> json | none { json_member(self, key) }
  fn dec_string (self) -> string | parse_err { json_as_string(self) }
  fn dec_int (self) -> int | parse_err { json_as_int(self) }
  fn dec_float (self) -> float | parse_err { json_as_float(self) }
  fn dec_bool (self) -> bool | parse_err { json_as_bool(self) }
  fn dec_byte (self) -> byte | parse_err { json_as_byte(self) }
  fn dec_u32 (self) -> u32 | parse_err { json_as_u32(self) }
  fn dec_char (self) -> char | parse_err { json_as_char(self) }
  fn dec_bytes (self) -> bytes | parse_err { json_as_bytes(self) }
}

impl encoder for json {
  fn enc_bool (self, value: bool) -> json { json_bool(value: value) }
  fn enc_int (self, value: int) -> json { json_int(value: value) }
  fn enc_float (self, value: float) -> json { json_float(value: value) }
  fn enc_string (self, value: string) -> json { json_string(value: value) }
  fn enc_byte (self, value: byte) -> json { json_of_byte(value) }
  fn enc_u32 (self, value: u32) -> json { json_of_u32(value) }
  fn enc_char (self, value: char) -> json { json_of_char(value) }
  fn enc_bytes (self, value: bytes) -> json { json_of_bytes(value) }
  fn enc_array (self, items: list[json]) -> json { json_array(items: items) }
  fn enc_object (self, fields: map[string, json]) -> json { json_object(fields: fields) }
}
