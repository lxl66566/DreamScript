// The @std string face: the pure string operations that left the
// ambient core as the reserved package's own source. Every declaration
// here names a builtin core
// native the lowering routes by name at the callee resolution seam, so
// the package owns the spelling while the engine owns the seam. The
// face rides composed into the @std bundle's core member (beside the
// json face, whose free calls into this face stay same-file with it)
// and into both ambient readings — the entry script session's and the
// merged source's — keeping the bare spellings and the UFCS forms
// (`s.trim()`, `"42".parse_int()`) alive while the migration runs. The
// core string face stays ambient-owned: `str`, the `concat` seam the
// interpolation and `+` spellings lower through, the sort key and
// content hash (`str_compare`, `str_hash`) the derive families read,
// and the `char_of`/`code_of` codepoint pair.

// The one separator type both ways: `split` slices per its char and
// `join` renders the neighbors around it. An empty-separator fold has
// no spelling through the pair, so it composes in ds source.
pub extern fn join (parts: list[string], sep: char) -> string
pub extern fn trim (s: string) -> string
pub extern fn parse_int (s: string) -> int | parse_err
pub extern fn parse_float (s: string) -> float | parse_err
pub extern fn split (s: string, sep: char) -> list[string]
// The checked slice: the chars between the two positions, none
// outside `0 <= start <= end` and the string's char count — never
// clamping and never a trap.
pub extern fn substring (s: string, start: int, end: int) -> string | none
pub extern fn to_upper (s: string) -> string
pub extern fn to_lower (s: string) -> string
// The checked char read: the char at the position, none outside
// the string's range — the old total spelling answered the empty
// string instead.
pub extern fn char_at (s: string, i: int) -> char | none
// The string search family:
// `contains` answers the membership read, the empty needle always
// occurring; `index_of` answers the first occurrence's char index
// (substring's indexing, so the answer composes with the checked
// slice), a miss none and the empty needle index 0; `replace` swaps
// every non-overlapping occurrence in one left-to-right pass, the
// inserted text never re-scanned, the empty needle inserting `with` at
// every char boundary.
pub extern fn contains (haystack: string, needle: string) -> bool
pub extern fn index_of (haystack: string, needle: string) -> int | none
pub extern fn replace (haystack: string, needle: string, with: string) -> string

// The zero-copy parsing face: one view over a
// counted share of a base string — the `s` field's Ref word is the
// share, safe under precise counting with no model change — carrying
// the half-open char range [start, end) into it. Every position is a
// char index, the checked reads' own vocabulary, so a view composes
// with `char_at` and `substring` with no boundary translation, and a
// free `len` owns the dot position, so the range spells its two
// bounds instead of a length. Construction validates the range against
// the base's char count (the checked-API convention: the none member
// outside it, never clamping and never a trap), the members answer
// without substring allocation, and `view_text` is the one
// materializing door — a parser holds cursors into a shared base and
// pays the copy only at the exit that needs the text.
pub struct string_view { s: string, start: int, end: int }

pub fn view (s: string, start: int, end: int) -> string_view | none {
  if start < 0 || end < start || end > len(s) { none }
  else { string_view { s: s, start: start, end: end } }
}

pub fn view_len (v: string_view) -> int {
  v.end - v.start
}

pub fn view_char_at (v: string_view, i: int) -> char | none {
  if i < 0 || i >= v.end - v.start {
    none
  } else {
    const c = char_at(v.s, v.start + i)
    c
  }
}

// The slice composing a further view: the range validated against this
// view's own bounds, so the composed view can never fall off the base
// it already sits inside.
pub fn view_slice (v: string_view, start: int, end: int) -> string_view | none {
  if start < 0 || end < start || v.start + end > v.end {
    none
  } else {
    const inner = view(v.s, v.start + start, v.start + end)
    inner
  }
}

// The content equality against a whole string: the length read first,
// then the char walk over both — no substring allocation on either
// side of the compare.
pub fn view_eq (v: string_view, other: string) -> bool {
  if v.end - v.start != len(other) { return false }
  var i = 0
  var same = true
  while i < v.end - v.start {
    if char_at(v.s, v.start + i).unwrap_or('\0') != char_at(other, i).unwrap_or('\0') {
      same = false
    }
    i += 1
  }
  same
}

// The materializing read back out: the one door that allocates, over a
// range construction already validated.
pub fn view_text (v: string_view) -> string {
  substring(v.s, v.start, v.end).unwrap_or("")
}
