// The @std string face: the operations over the core string face that
// stay free spellings — the separator-pair `join` (the list receiver),
// the format family, and the zero-copy `string_view` face. The
// string-receiving operations (the checked slice and char read, the
// case pair, the separator `split`, the search family, the parses)
// moved onto the string type's member tier in the ambient core, so
// this face's own calls into their seams stay same-file with the
// composed core. Every declaration here names a builtin core native
// the lowering routes by name at the callee resolution seam (or a
// plain ds body over those), so the package owns the spelling while
// the engine owns the seam. The face rides composed into the @std
// bundle's core member (beside the json face, whose free calls into
// this face stay same-file with it) and into both ambient readings —
// the entry script session's and the merged source's — keeping the
// bare spellings alive while the migration runs. The core string face
// stays ambient-owned: `str`, the `concat` seam the interpolation and
// `+` spellings lower through, the moved operations' private seams,
// the sort key and content hash (`str_compare`, `str_hash`) the derive
// families read, and the `char_of`/`code_of` codepoint pair.

// The list-side separator spelling: `join` renders the neighbors'
// texts around the separator (`split` moved onto the string member
// tier, the string receiver's own face). The union stages over the
// ordinary tagged layout — the tag word beside the member's own payload
// word, a char the integer slot's code point and a string the text
// Ref — and the native reads that payload back.
/// Renders the neighbors' texts around the separator.
pub extern fn join (parts: list[string], sep: char | string) -> string

// The format family: plain ds source over the builtin faces. `hex`
// spells the lowercase hex digits of a non-negative word (a negative
// value answers its minus sign and the magnitude's digits); `pad_left`
// and `pad_right` are the two alignments, the pad char repeated to the
// width and a past-the-width value answering itself. Floats compose
// over the builtin `str_fixed` formatter.
/// The lowercase hex digits of the word; a negative value keeps
/// its sign.
pub fn hex (n: int) -> string {
  if n < 0 {
    return "-${hex(-n)}"
  }
  if n == 0 {
    return "0"
  }
  var out = ""
  var v = n
  while v > 0 {
    const nibble = v & 15
    // the codepoint reader answers the char word; the digit codes are
    // scalars, so the fallback never fires
    const digit = char_of(if nibble < 10 { 48 + nibble } else { 87 + nibble }).unwrap_or('\0')
    out = "${digit}${out}"
    v = v >> 4
  }
  out
}

/// The text padded on the left to the width with the pad char;
/// a longer text answers itself.
pub fn pad_left (s: string, width: int, pad: char) -> string {
  const missing = width - len(s)
  if missing <= 0 {
    return s
  }
  var fill = ""
  var i = 0
  while i < missing {
    fill = "${fill}${pad}"
    i += 1
  }
  "${fill}${s}"
}

/// The text padded on the right to the width with the pad char;
/// a longer text answers itself.
pub fn pad_right (s: string, width: int, pad: char) -> string {
  const missing = width - len(s)
  if missing <= 0 {
    return s
  }
  var fill = ""
  var i = 0
  while i < missing {
    fill = "${fill}${pad}"
    i += 1
  }
  "${s}${fill}"
}

// The zero-copy parsing face: one view over a
// counted share of a base string — the `s` field's Ref word is the
// share, safe under precise counting with no model change — carrying
// the half-open char range [start, end) into it. Every position is a
// char index, the checked reads' own vocabulary, so a view composes
// with `char_at` and `substring` with no boundary translation, and a
// free `len` owns the dot position, so the range spells its two
// bounds instead of a length. Construction validates the range against
// the base's char count (the checked-API convention: the none member
// outside it, never clamping and never a trap), the members answer
// without substring allocation, and `view_text` is the one
// materializing door — a parser holds cursors into a shared base and
// pays the copy only at the exit that needs the text.
/// A zero-copy view: a counted share of a base string and the
/// half-open char range [start, end) into it.
pub struct string_view { s: string, start: int, end: int }

/// The validated view over the range, none outside the base's
/// char count.
pub fn view (s: string, start: int, end: int) -> string_view | none {
  if start < 0 || end < start || end > len(s) { none }
  else { string_view { s: s, start: start, end: end } }
}

/// The view's char count.
pub fn view_len (v: string_view) -> int {
  v.end - v.start
}

/// The char at the view-relative index, none outside the view.
pub fn view_char_at (v: string_view, i: int) -> char | none {
  if i < 0 || i >= v.end - v.start {
    none
  } else {
    const c = char_at(v.s, v.start + i)
    c
  }
}

// The slice composing a further view: the range validated against this
// view's own bounds, so the composed view can never fall off the base
// it already sits inside.
/// The inner view over a view-relative range, none outside this
/// view's bounds.
pub fn view_slice (v: string_view, start: int, end: int) -> string_view | none {
  if start < 0 || end < start || v.start + end > v.end {
    none
  } else {
    const inner = view(v.s, v.start + start, v.start + end)
    inner
  }
}

// The content equality against a whole string: the length read first,
// then the char walk over both — no substring allocation on either
// side of the compare.
/// Whether the view's text equals the string's, without
/// allocation.
pub fn view_eq (v: string_view, other: string) -> bool {
  if v.end - v.start != len(other) { return false }
  var i = 0
  var same = true
  while i < v.end - v.start {
    if char_at(v.s, v.start + i).unwrap_or('\0') != char_at(other, i).unwrap_or('\0') {
      same = false
    }
    i += 1
  }
  same
}

// The materializing read back out: the one door that allocates, over a
// range construction already validated.
/// The view's text, materialized — the face's one allocating
/// read.
pub fn view_text (v: string_view) -> string {
  substring(v.s, v.start, v.end).unwrap_or("")
}
