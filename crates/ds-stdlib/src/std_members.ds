// The migrated @std members (the library-boundary un-merge): the
// declarations that left the compiler-required ambient and live in the
// reserved package ds source. A graph that declares the @std dep binds
// these through the linked surface (an import selection validating
// against the exported entries of the package), and every undeclaring
// registration composes this file back into the merged ambient it
// always served — the two readings stay namespace-identical while the
// migration runs. The bodied members (the names a session can compose
// back and lower as ambient bodies) live in their own file beside this
// one, the session composition's source.

// A text row: keyed lookup over strings.
/// A text row: keyed lookup over strings.
pub type row = map[string, string]

// The config record (an optional port field beside plain ones). The
// reader/fallback externs that answered it are gone — no native
// answered them — so a package wanting them declares its own externs
// over this shape.
/// The config record: an optional port field beside plain ones.
pub struct config { host: string, port: int?, retries: int }

// An opaque response value. The fetch/consume externs that answered it
// are gone — no native answered them — so a package wanting them
// declares its own externs over this shape.
/// An opaque response value.
pub struct response

// The nursery demo fixed page list.
/// The nursery demo's fixed page list.
pub const urls = ["https://ds.dev", "https://example.org"]
