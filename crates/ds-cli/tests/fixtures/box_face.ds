// purpose: the `box[t]` owning pointer through `ds run`: a two-child tree
// declared through `box` builds, walks, and dies (the wrapper's deinit
// firing at the unique death while the branch cascade frees the tree),
// the held value crossing calls and instantiating per shape through a
// generic fn, and the container riding a list element as one `Ref`
// word per element.

struct twig {
  v: int
  left: box[twig] | none
  right: box[twig] | none
}

struct tracked: ~Copyable {
  id: int
  root: box[twig] | none
  deinit { println("tracked ${self.id} dies") }
}

fn size(t: box[twig] | none) -> int {
  match t {
    none => 0
    b => {
      const w = b.get()
      1 + size(w.left) + size(w.right)
    }
  }
}

fn leaf(v: int) -> box[twig] | none {
  box[twig](twig { v: v, left: none, right: none })
}

fn grab[t](b: box[t]) -> t {
  b.get()
}

#[derive(show)]
struct wrap {
  n: int
  b: box[string]
}

fn main() -> int {
  var t: box[twig] | none = none
  t = box[twig](twig { v: 2, left: leaf(1), right: leaf(3) })
  const xs = [box[int](5), box[int](6)]
  println("tree ${size(t)} boxes ${xs[0].get()} ${xs[1].get()}")
  const r = tracked { id: 4, root: t }
  match r.root {
    none => println("root gone")
    b => println("root ${grab(b).v}")
  }
  println("held ${grab(box[string]("hey"))}")
  // the consuming unbox: the last share moves out whole-span and frees
  println("unbox ${box[int](42).unbox()}")
  const moved = box[string]("move me")
  const taken = moved.unbox()
  println("taken ${taken}")
  // a holder that survives reads a copy — value semantics
  const kept = box[int](3)
  const copy = kept.unbox()
  println("kept ${copy} still ${kept.get()}")
  // the shared-count unbox: a var holder shares the count, the dying
  // receiver copies out, the holder keeps the value
  var b = box[int](5)
  var c = b
  const taken_c = b.unbox()
  println("shared ${taken_c} held ${c.get()}")
  // the structural equality descends into the held value
  println("eq ${box[int](5) == box[int](5)} ${box[int](5) != box[int](6)}")
  println("eqstr ${box[string]("a") == box[string]("a")}")
  println("eqnest ${box[box[int]](box[int](7)) == box[box[int]](box[int](7))}")
  const ys = [box[int](1), box[int](2)]
  println("eqlist ${ys == [box[int](1), box[int](2)]} ${ys.contains(box[int](2))}")
  println("eqwrap ${wrap { n: 1, b: box[string]("x") } == wrap { n: 1, b: box[string]("x") }}")
  // the show face renders the held value
  println("show ${kept} ${box[box[int]](box[int](7))}")
  println("derived ${wrap { n: 1, b: box[string]("x") }}")
  0
}
