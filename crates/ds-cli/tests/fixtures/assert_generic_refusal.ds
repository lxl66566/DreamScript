// The refused generic assert_eq spelling: the abort shape's check
// refusal fires first — the panic return's type variable never solves
// inside the if arm, so the arm's value unions it into a `() | t` that
// does not fit the unit answer (the never-returns marker question,
// item 139). The equality compare underneath no longer refuses at
// lowering — the per-shape instantiation lowers a site's solved
// one-word shape through its own instance — so the isolated compare
// runs in assert_generic_equality.ds.

fn assert_eq_any[t] (a: t, b: t, msg: string) -> () {
  if !(a == b) { panic(msg) }
}

fn main() -> int {
  assert_eq_any(1, 1, "ints")
  0
}
