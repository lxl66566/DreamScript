// purpose: the negative pin of the file face's linear discipline — a
// moved file binding used afterwards refuses at the affine pass, a
// compile-time fact about the package-owned type.

fn eat(move f: file_handle) -> () { }

fn moved(path: string) -> () {
  const f = open_file(path)
  eat(f)
  const b = read_exact(f, 4)
}

moved("file_time_probe.txt")
