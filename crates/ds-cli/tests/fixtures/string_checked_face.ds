// purpose: the checked string reads (B8) over the real ambient —
// substring answers the chars between two positions and char_at the
// char at a position, out-of-range slices and indexes answering none
// (never clamping); the probe extracts the hit side through match,
// is-narrowing, and the unwrap_or fallback over both members, and reads
// the char member out through its printable interpolation.

fn slice_match(s: string) -> string {
  match substring(s, 0, 2) {
    none => "none"
    part => part
  }
}

fn slice_narrowed(s: string) -> string {
  const r = substring(s, 0, 99)
  if r is string { "hit" } else { "none" }
}

fn slice_negative(s: string) -> string {
  const r = substring(s, -1, 2)
  if r is none { "none" } else { "hit" }
}

fn slice_fallback(s: string) -> string {
  substring(s, 5, 3).unwrap_or("none")
}

fn char_match(s: string) -> string {
  match char_at(s, 1) {
    none => "none"
    c => "${c}"
  }
}

fn char_narrowed(s: string) -> string {
  const c = char_at(s, 9)
  if c is char { "hit" } else { "none" }
}

fn char_fallback(s: string) -> char {
  char_at(s, 0).unwrap_or('x')
}

fn main () -> () {
  println(slice_match("hello"))
  println(slice_narrowed("hello"))
  println(slice_negative("hello"))
  println(slice_fallback("hello"))
  println(char_match("hello"))
  println(char_narrowed("hello"))
  println("${char_fallback("")}")
  println(substring("héllo", 1, 3).unwrap_or("?"))
}
