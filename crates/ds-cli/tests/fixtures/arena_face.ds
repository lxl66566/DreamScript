// The arena face through `ds run`: the handle table the read-side
// aliasing round targeted — the at answers reading as counted values
// under the collection value semantics (a mutating native on the
// shared-count answer landing on its copy, so cyclic building through
// at answers is dead for reference elements until the read-side
// aliasing round) — beside the retire/reuse walk and the free `len`
// count.

fn main() -> () {
  var a = arena[list[int]]()
  const h0 = a.insert([1])
  const h1 = a.insert([2])
  const h2 = a.insert([])
  var s0 = a.at(h0)
  s0.push(9)
  println("copy ${s0.len()} kept ${a.at(h0).len()}")
  var cur = h0
  var hops = 0
  while hops < 2 {
    var links = a.at(cur)
    const step = links.first()
    if step is int { cur = step } else { println("no successor") }
    hops += 1
  }
  println("walk ${hops} home ${cur == h2}")
  a.remove(h1)
  const h3 = a.insert([42])
  var s0b = a.at(h0)
  s0b.push(h3)
  println("len ${a.len()} at0 ${a.at(h0).len()}")
}
