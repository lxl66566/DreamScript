// The collection `len` through the `ds` binary in source mode: the
// member spellings over a string, a list, and a bytes receiver, one
// dispatched body behind the private seam.

fn main() -> () {
  const words = ["alpha", "beta", "gamma"]
  const name = "DreamScript"
  const raw = bytes_of(byte_list(utf8_encode("héllo")))
  println("string ${name.len()}")
  println("list ${words.len()}")
  println("bytes ${raw.len()}")
}
