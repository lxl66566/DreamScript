// The member shape the runtime seam refuses this round: a generic
// inherent impl over a builtin collection whose parameter or answer
// spans the collection's own type variable has no static word kind (the
// free generic fn's Raw-word shape is the free tier's alone), so the
// checked read keeps its `map_get` native seam and the member spelling
// refuses at lowering while the check stays clean.

impl[k, v] map[k, v] {
  fn get (self, key: k) -> v | none {
    const val = map_get(self, key)
    val
  }
}

fn main() -> () {
  var m = map[string, int]()
  map_set(m, "one", 1)
  println("${m.get("one").unwrap_or(0)}")
}
