// The member shape the runtime seam refuses: a ds-bodied inherent
// member over a builtin collection whose parameter or answer spans the
// collection's own type variable has no static word kind (the ambient's
// own `get`/`push`/`set` members declare no body and route to the
// collection natives directly), so the spelling checks clean and
// refuses at lowering.

impl[t] list[t] {
  fn append(mut self, x: t) -> list[t] {
    self
  }
}

fn main() -> int {
  var xs = [1, 2]
  xs.append(9)
  return xs.len()
}
