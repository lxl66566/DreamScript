// i64::MIN written as one negated literal: the sign folds into the
// literal's range check, so the min value lowers as the min constant,
// prints its full digits, and equals the computed min.
fn main() -> int {
  const x = -9223372036854775808
  println("${x}")
  if x == 0 - 9223372036854775807 - 1 { println("min") }
  0
}
