// Ambient stdlib stubs for conformance/generics_coherent_traits.ds per
// the corpus README's generics list: signatures only, the M3 stdlib owns
// the bodies. A `ds check` package is exactly the files given, so the
// vocabulary a source needs arrives with it as a package member.
tag int
tag string
tag bool
trait Copyable { }
struct list[t]
extern fn cons[t] (x: t, xs: list[t]) -> list[t]
extern fn head[t] (xs: list[t]) -> t?
extern fn tail[t] (xs: list[t]) -> list[t]
extern fn join (parts: list[string], sep: string) -> string
extern fn map[t, r] (xs: list[t], f: fn(t) -> r) -> list[r]
extern fn str[t] (v: t) -> string
