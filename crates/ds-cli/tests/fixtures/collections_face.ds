// The taught collection face through the `ds` binary: the empty
// constructors, the UFCS member spellings over the free generic's
// instance table (the List and Map receivers), the inherent member over
// the map's ordered key face, and split/join over the one char separator.

fn main() -> () {
  var xs = list[int]()
  list_push(xs, 1)
  list_push(xs, 2)
  const parts = split("alpha;beta;gamma", ';')
  var m = map[string, int]()
  map_set(m, "one", 1)
  map_set(m, "two", 2)
  println("len ${xs.len()} ${parts.len()} ${m.len()}")
  println("keys ${m.keys().len()}")
  println("csv ${parts.join(',')}")
  println("empty ${list[int]().len()} ${map_len(map[string, int]())}")
}
