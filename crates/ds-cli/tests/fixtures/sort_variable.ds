// A sort over a generic body's own type variable: the bound answer
// re-solves through the lens at lowering — the entering site's
// substitution concretizes the variable, and the serving instance's
// compare body stages as the callable (the per-shape instance the
// plan keyed, the ord instances riding the key).

fn sort_any[t: ord](xs: list[t]) -> list[t] { xs.sort() }

fn main() -> int {
  const ys = sort_any([3, 1, 2])
  for x in ys { println("${x}") }
  0
}
