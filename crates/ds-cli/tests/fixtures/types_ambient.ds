// Ambient stdlib stubs for conformance/types_hybrid.ds per the corpus
// README's types_hybrid list: signatures only, the M3 stdlib owns the
// bodies. A `ds check` package is exactly the files given, so the
// vocabulary a source needs arrives with it as a package member.
tag int
tag float
tag string
tag bool
trait Copyable { }
struct list[t]
struct map[k, v]
extern fn read_file (path: string) -> string | io_err
extern fn parse_json (text: string) -> json | io_err
extern fn str[t] (v: t) -> string
extern fn log (msg: string) -> ()
extern fn default_config () -> config
extern fn get[k, v] (m: map[k, v], key: k) -> v | none
