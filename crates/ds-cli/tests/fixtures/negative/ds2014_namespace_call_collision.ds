// A call-form name present in both namespaces [F9]: the tag and the
// function share `page`; the call is an ambiguity error, never a priority
// search. The brace form and the bare use still resolve (their own
// positions), so only the call reports.

tag int
tag page
fn page(n: int) -> int { n }
fn caller(n: int) -> int { page(n) }
