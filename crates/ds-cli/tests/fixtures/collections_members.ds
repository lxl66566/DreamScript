// The mutation and membership members through the `ds` binary: the
// indexed element store, splice, and removal over the mut windows (an
// out-of-range store or removal trapping loud — the place must resolve,
// no miss answer exists to extract), the stride-resetting emptying, the
// map's row removal (a missing key a no-op), the membership reads (the
// list probe and the map row), and the entry-order pair list with the
// removed rows' counts released.

fn main() -> () {
  var xs = [1, 2, 3]
  xs.set(1, 20)
  xs.insert(0, 9)
  xs.remove(3)
  println("spliced ${xs.get(0).unwrap_or(-1)} ${xs.get(1).unwrap_or(-1)} ${xs.get(2).unwrap_or(-1)}")
  var zs = [4, 5]
  zs.clear()
  zs.push(7)
  println("cleared ${zs.get(0).unwrap_or(-1)}")
  var ys = ["a", "b"]
  println("probed ${ys.contains("a")} ${ys.contains("z")}")
  var m = map[string, int]()
  m.set("one", 1)
  m.set("two", 2)
  m.remove("one")
  m.remove("nope")
  println("removed ${m.contains("two")} ${m.contains("one")} ${m.len()}")
  var pairs = ""
  for e in m.entries() {
    const (k, v) = e
    pairs += "${k}=${v}"
  }
  println("pairs ${pairs}")
}
