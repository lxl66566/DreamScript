// Kernel: hot var-mutation loop — integer mul/add/mod per iteration plus a
// parity branch. The Lehmer generator x * 48271 % 2147483647 keeps every
// intermediate below 2^47, so i64, f64-exact JS, and bignum Python see the
// same values.

fn main() -> () {
  var x: int = 1
  var acc: int = 0
  var i: int = 0
  while i < 10000000 {
    x = (x * 48271) % 2147483647
    if x % 2 == 0 {
      acc += x % 97
    } else {
      acc += x % 89
    }
    i += 1
  }
  println("result: ${acc}")
}
