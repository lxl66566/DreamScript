// Kernel: the container closes — cons/first/tail/collect/max over
// ints (the CALLG builtin 32-37 surface). A cons ladder builds a
// 15000-element list (each cons copies the whole predecessor, ~N^2/2 =
// 112M element words), then a first/tail drain walks it down one element
// per iteration keeping a running max (tail copies the remainder each
// step, another 112M words, with one first and one max call per element),
// then 150 collect copies re-read the full list (2.25M words plus one
// len per copy), and first pins the checked head of the full list. The
// checked reads answer int | none, extracted with the .ok/.err handler
// chain. Every integer intermediate stays non-negative below 2^47.

fn main() -> () {
  var xs: list[int] = list[int]()
  var i: int = 0
  while i < 15000 {
    xs = xs.cons((i * 37) % 900 + 100)
    i += 1
  }
  var m: int = 0
  var rest = xs
  var c: int = 0
  while c < 15000 {
    const h = rest.first()
    const v = h.ok((x: int) => x).err((_: none) => -1)
    m = m.max(v)
    rest = rest.tail()
    c += 1
  }
  var total: int = 0
  var r: int = 0
  while r < 150 {
    const ys = xs.collect()
    total += ys.len()
    r += 1
  }
  const f0 = xs.first()
  const first_v = f0.ok((x: int) => x).err((_: none) => -1)
  println("result: ${xs.len()} ${m} ${total} ${first_v}")
}
