// Kernel: the lambda combinators — map/filter/reduce chains over
// list[int] and list[string] with non-capturing lambdas (the CALLG
// reentry surface: the VM reenters the interpreter once per element per
// combinator). The int pipeline runs 250 rounds of map (x*2), filter
// (x % 3 == 0), reduce (sum) over a 10000-element list built with
// the push member; the string pipeline runs 40 rounds of map (suffix concat),
// filter (len < 5), reduce (concat join) over a 1000-element list,
// checksummed by length so the golden stays short. Every lambda is
// non-capturing by construction, so the reentry measures CALLG
// dispatch alone, without capture build/copy traffic. Every integer
// intermediate stays non-negative below 2^47.

fn main() -> () {
  var xs: list[int] = list[int]()
  var i: int = 0
  while i < 10000 {
    xs.push((i * 37) % 900 + 100)
    i += 1
  }
  var sum: int = 0
  var r: int = 0
  while r < 250 {
    const doubled = xs.map((x: int) => x * 2)
    const kept = doubled.filter((x: int) => x % 3 == 0)
    sum += kept.reduce(0, (a: int, b: int) => a + b)
    r += 1
  }
  var ys: list[string] = list[string]()
  var j: int = 0
  while j < 1000 {
    ys.push("w${j % 40}")
    j += 1
  }
  var lensum: int = 0
  var q: int = 0
  while q < 40 {
    const banged = ys.map((w: string) => w.concat("!"))
    const short = banged.filter((w: string) => w.len() < 5)
    const joined = short.reduce("", (a: string, b: string) => a.concat(b))
    lensum += joined.len()
    q += 1
  }
  println("result: ${sum} ${xs.len()} ${lensum} ${ys.len()}")
}
