// Kernel: the list surface — build one delimited string (N = 20000
// three-digit pieces joined by ';', grouped like strings.ds to bound
// copying, the trailing separator chopped by a known-length substring),
// split it once into N parts, then 120 rounds of checked list_get reads
// checksummed with parse_int, and a bounded list_concat ladder: each
// concat copies both operands into a fresh list, so C = 32 concats of
// the N-part list cost ~N*C^2/2 = 10M element words — C stays small so
// the copy work dominates the ladder without blowing the time budget.
// The final sweep re-checksums all N*(C+1) ladder elements to pin its
// contents. The checked read answers string | none and the parse
// answers int | parse_err, both extracted with .err handler chains;
// accumulators seed with the empty string literal, mirrored exactly in
// the peer kernels.

fn main() -> () {
  var s: string = ""
  var gi: int = 0
  while gi < 20 {
    var piece: string = ""
    var k: int = 0
    while k < 1000 {
      const v = (gi * 1000 + k) * 37 % 900 + 100
      piece = "${piece}${v};"
      k += 1
    }
    s = s.concat(piece)
    gi += 1
  }
  const n: int = 20000
  s = s.substring(0, n * 4 - 1).ok((x: string) => x).err((_: none) => "")
  const parts = split(s, ';')
  var sum: int = 0
  var p: int = 0
  while p < 120 {
    var i: int = 0
    while i < n {
      const cell = list_get(parts, i)
      const w = cell.ok((x: string) => x).err((_: none) => "0")
      sum += w.parse_int().err((_: parse_err) => 0)
      i += 1
    }
    p += 1
  }
  var acc: list[string] = parts
  var c: int = 0
  while c < 32 {
    acc = list_concat(acc, parts)
    c += 1
  }
  var total: int = 0
  var j: int = 0
  const m: int = n * 33
  while j < m {
    const cell = list_get(acc, j)
    const w = cell.ok((x: string) => x).err((_: none) => "0")
    total += w.parse_int().err((_: parse_err) => 0)
    j += 1
  }
  println("result: ${sum} ${total} ${len(acc)}")
}
