// Kernel: the fiber path — spawn/join nursery cycles. The every-cycle
// burst opens a fresh nursery and spawns two children with tiny bodies:
// the first computes on a copied-in int capture, the second touches a
// string Ref capture so the spawn-seam copy-in acquire rides (the
// label is loop-invariant so string work stays out of the cycle);
// scope exit joins both. Every 100th cycle a spawned child opens its
// own nursery while the enclosing drive owns it — the interlock's
// two-level join-across-levels shape, kept at 1% so the cycle cost
// dominates. One final walk re-reads the shared out-list through
// checked get member with .ok/.err extraction to checksum the children's
// answers; the walk runs once, not per cycle. Every integer
// intermediate stays non-negative below 2^47.

fn deep(i: int, label: string) -> int | net_err {
  var sub: list[int] = list[int]()
  nursery {
    spawn {
      nursery {
        spawn {
          sub.push(len(label) + i % 7)
        }
      }
    }
  }
  const cell = sub.get(0)
  cell.ok((e: int) => e).err((_: none) => 0)
}

fn main() -> () {
  const n: int = 200000
  const label: string = "fiber-probe"
  var out: list[int] = list[int]()
  var deep_sum: int = 0
  var i: int = 0
  while i < n {
    nursery {
      spawn {
        out.push((i % 97) + (i % 13))
      }
      spawn {
        out.push(len(label) + i % 11)
      }
    }
    if i % 100 == 99 {
      match deep(i, label) {
        timeout => deep_sum += 0
        refused => deep_sum += 0
        v => deep_sum += v
      }
    }
    i += 1
  }
  var sum: int = 0
  var j: int = 0
  const m: int = len(out)
  while j < m {
    const cell = out.get(j)
    sum += cell.ok((e: int) => e).err((_: none) => 0)
    j += 1
  }
  println("result: ${sum} ${deep_sum} ${m}")
}
