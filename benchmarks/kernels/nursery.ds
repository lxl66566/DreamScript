// Kernel: the fiber path — spawn/join nursery cycles. The every-cycle
// burst opens a fresh nursery and spawns two children answering through
// the join channel: the first computes on a copied-in int capture, the
// second touches a string Ref capture so the spawn-seam copy-in acquire
// rides (the label is loop-invariant so string work stays out of the
// cycle); the block's value carries the answers in spawn order, and the
// drive folds them into the shared out-list — a spawned body may never
// hold a mut window over an outlived binding, so the drive alone writes.
// Every 100th cycle a spawned child opens its own nursery while the
// enclosing drive owns it — the interlock's two-level join-across-levels
// shape, kept at 1% so the cycle cost dominates. One final walk re-reads
// the out-list through the checked get member with .ok/.err extraction
// to checksum the children's answers; the walk runs once, not per
// cycle. Every integer intermediate stays non-negative below 2^47.

fn deep(i: int, label: string) -> int | net_err {
  const sub = nursery {
    spawn {
      const inner = nursery {
        spawn {
          label.len() + i % 7
        }
      }
      const cell = inner.get(0)
      cell.ok((e: int) => e).err((_: none) => 0)
    }
  }
  const cell = sub.get(0)
  cell.ok((e: int) => e).err((_: none) => 0)
}

fn main() -> () {
  const n: int = 200000
  const label: string = "fiber-probe"
  var out: list[int] = list[int]()
  var deep_sum: int = 0
  var i: int = 0
  while i < n {
    const got = nursery {
      spawn {
        (i % 97) + (i % 13)
      }
      spawn {
        label.len() + i % 11
      }
    }
    const a = got.get(0)
    out.push(a.ok((e: int) => e).err((_: none) => 0))
    const b = got.get(1)
    out.push(b.ok((e: int) => e).err((_: none) => 0))
    if i % 100 == 99 {
      match deep(i, label) {
        timeout => deep_sum += 0
        refused => deep_sum += 0
        addr_in_use => deep_sum += 0
        reset => deep_sum += 0
        net_other { msg } => deep_sum += 0
        v => deep_sum += v
      }
    }
    i += 1
  }
  var sum: int = 0
  var j: int = 0
  const m: int = out.len()
  while j < m {
    const cell = out.get(j)
    sum += cell.ok((e: int) => e).err((_: none) => 0)
    j += 1
  }
  println("result: ${sum} ${deep_sum} ${m}")
}
