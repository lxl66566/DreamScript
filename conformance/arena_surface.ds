// source: todo item 119, the read-side aliasing round (ruled 2026-11-25)
// purpose: the @std arena's library surface — the walk over the rows the inserts seeded, the at answer as a counted value read (a mutating native on the shared-count answer landing on its copy, so the stored row keeps its seed and building cyclic graphs through at answers is dead for reference elements until the read-side aliasing round), the retire/reuse walk under the generation bump, and the free len — with the dangling trap's probe declared but never called from main (its deterministic report is pinned in the ds-lower arena_e2e and ds-cli arena_face suites)
// items:
// value-read-walk: stage: run
// retire-reuse: stage: run
// read-through: stage: run
// handle-int-word: stage: run
// dangling-probe: stage: run (traps deterministically at the run; the probe stays uncalled from main, exactly shift_bitwise's own trap items)
// main: stage: run

// The walk over the rows the inserts seeded (a fresh value each, the
// arena owning its own copy), and the at answer as a counted value
// read: a mutating native on the shared-count answer lands on its
// copy, the stored row keeping its seed.
fn value_read_walk() -> int {
  var a = arena[list[int]]()
  const h0 = a.insert([1])
  const h1 = a.insert([2])
  const h2 = a.insert([])
  var s0 = a.at(h0)
  s0.push(9)
  if a.len() != 3 { return 1 }
  if s0.len() != 2 { return 2 }
  if a.at(h0).len() != 1 { return 3 }
  var cur = h0
  var hops = 0
  while hops < 2 {
    var links = a.at(cur)
    const step = links.first()
    if step is int { cur = step } else { return 4 }
    hops += 1
  }
  if cur != h2 { return 5 }
  hops
}

// The removal retires the element (the free len observing it), the
// reuse answers the retired slot under the bumped generation, and the
// two handles disagree though they name the one slot.
fn retire_reuse() -> int {
  var a = arena[int]()
  const old = a.insert(10)
  if a.len() != 1 { return 1 }
  a.remove(old)
  if a.len() != 0 { return 2 }
  const fresh = a.insert(99)
  if a.len() != 1 { return 3 }
  if a.at(fresh) != 99 { return 4 }
  if old == fresh { return 5 }
  0
}

// The handle is a copyable int word: it crosses calls as a plain value
// and compares structurally — the cross-call cursor the round names.
fn read_through(h: int, mut a: arena[int]) -> int {
  a.at(h)
}

fn handle_int_word() -> int {
  var a = arena[int]()
  const h = a.insert(7)
  read_through(h, a)
}

// The deterministic trap: a handle copy taken before the removal names
// a retired slot, and at answers the trap instead of the reused
// element. Declared but never called from main — its report and exit
// status are pinned in the ds-cli arena_face suite.
fn dangling_probe() -> int {
  var a = arena[int]()
  const stale = a.insert(41)
  a.remove(stale)
  a.insert(99)
  const v = a.at(stale)
  v
}

fn main() -> () {
  println("walk ${value_read_walk()}")
  println("reuse ${retire_reuse()}")
  println("crossed ${handle_int_word()}")
}
