// source: frozen archive catalog 01-types (seed corpus)
// purpose: config parser exercising enum-minted cases, set-typed errors, is-narrowing, bare return, ?, .err, structural ==
// items:
// cfg_err: stage: typecheck
// log: stage: typecheck
// default_config: stage: typecheck
// get: stage: typecheck
// get_port: stage: run
// load: stage: run
// cfg: stage: run
// kv: stage: run
// same: stage: run

// the json value family: the ambient's own enum [B3] (payloaded cases
// minted by one enum), whose parse_json names it [G4]

// the config error family: one bare case and one payload case; case
// names enter the tag namespace, so `int | missing | bad_port` is a set
// expression over them exactly like over standalone tags (io failures
// ride the ambient's io_err)
enum cfg_err {
  missing
  bad_port { got: int }
}

// the config fallback's seams, file-owned since the ambient shed its dead
// declarations (no native answers these callees; the uses keep their
// staged spellings and refuse at lowering as the header records)
extern fn log(msg: string) -> ()
extern fn default_config() -> config
extern fn get[k, v](m: map[k, v], key: k) -> v | none

fn get_port(j: json) -> int | missing | bad_port {
  if j is json_object {
    const pv = j.fields.get("port")
    if pv is none { return missing }
    if pv is json_int && pv.value >= 1 && pv.value <= 65535 { pv.value } else { bad_port(got: -1) }
  } else {
    missing
  }
}

fn load(path: string) -> config | io_err | parse_err | cfg_err {
  const text = read_file(path)?
  const port = get_port(parse_json(text)?)?
  config { host: "localhost", port, retries: 3 }
}

const cfg = load("app.cfg").err((e) => {
  match e {
    b if b is bad_port => log("bad port ${b.got}")
    _ => log("config read failed")
  }
  default_config()
})

const kv = ("host", 8080)
const same = cfg == default_config()
