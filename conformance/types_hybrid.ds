// source: docs/en/design-decisions.md section 13.1 (types hybrid)
// purpose: config parser exercising nominal tags, set-typed errors, is-narrowing, or-return, ?, .err, structural ==
// items:
// io_err: stage: typecheck
// missing: stage: typecheck
// bad_port: stage: typecheck
// cfg_err: stage: typecheck
// json_null: stage: typecheck
// json_bool: stage: typecheck
// json_num: stage: typecheck
// json_str: stage: typecheck
// json_arr: stage: typecheck
// json_obj: stage: typecheck
// json: stage: typecheck
// config: stage: typecheck
// get_port: stage: run
// load: stage: run
// cfg: stage: run
// kv: stage: run
// same: stage: run

// nominal atoms [B1]: unit tags with distinct identity, struct with payload
tag io_err
tag missing
struct bad_port { got: int }
type cfg_err = io_err | missing | bad_port

// json value atoms: the record references Json without declaring it, atoms added here
tag json_null
tag json_bool
struct json_num { value: float }
struct json_str { value: string }
struct json_arr { items: list[json] }
struct json_obj { fields: map[string, json] }
type json = json_null | json_bool | json_num | json_str | json_arr | json_obj

struct config { host: string, port: int, retries: int }

const get_port = (j: json) -> int | missing | bad_port {
  if j is json_obj {
    const pv = j.fields.get("port") or return missing
    if pv is int && pv >= 1 && pv <= 65535 { pv } else { bad_port { got: -1 } }
  } else {
    missing
  }
}

const load = (path: string) -> config | cfg_err {
  const text = read_file(path)?
  const port = get_port(parse_json(text)?)?
  config { host: "localhost", port, retries: 3 }
}

const cfg = load("app.cfg").err((e) => {
  match e {
    b if b is bad_port => log("bad port ${str(b.got)}"),
    _                  => log("config read failed"),
  }
  default_config()
})

const kv = ("host", 8080)
const same = cfg == default_config()
