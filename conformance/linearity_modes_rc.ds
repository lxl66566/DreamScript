// source: frozen archive catalog 02-linearity-ownership (seed corpus)
// purpose: linear file with deinit, mut parameter windows, affine buffer move, COW split, fused map chain
// items:
// raw_fd: stage: typecheck
// io_error: stage: typecheck
// close: stage: typecheck
// to_u32_le: stage: typecheck
// file: stage: typecheck
// read_u32: stage: run
// sum_file: stage: run
// words: stage: run
// lens: stage: run
// total: stage: run

type raw_fd = int
tag io_error

// the fd close and the little-endian read, file-owned since the ambient
// shed its dead declarations (no native answers these callees; the uses
// keep their staged spellings and refuse at lowering as the header
// records — to_u32_le consumes its bytes, the move the affine gate pins)
extern fn close(fd: raw_fd) -> ()
extern fn to_u32_le(move b: bytes) -> u32

struct file: ~Copyable {
  fd: raw_fd
  deinit { close(self.fd) }
}

fn read_u32(mut f: file) -> u32 | io_error {
  const b = f.read_exact(4)?
  b.to_u32_le()
}

fn sum_file(path: string) -> u32 | io_error {
  const f = open(path)
  var total: u32 = 0
  var n: u32 = 0
  while n < 1000 {
    total += read_u32(f)?
    n += 1
  }
  total
}

const words = ["alpha", "beta", "gamma"]
const lens = words.map((w) => w.len()).collect()
const total = sum_file("metrics.bin").err((_: io_error) => 0) + lens.len()
