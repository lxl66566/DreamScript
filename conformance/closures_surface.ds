// source: F2 "functions are values" and F7's trailing lambda, against the b07 callable-word seam audit 2026-11-10
// purpose: lambda values in every argument shape run through the callable words (fn-typed parameters, let-stored and passed lambdas, a capturing closure); the trailing-block sugar items wait on the block-argument round
// items:
// apply: stage: run
// twice: stage: run
// call_with_block: stage: typecheck
// call_with_lambda: stage: run
// call_one_arg: stage: run
// call_stored: stage: run
// call_passed: stage: run
// capture_over_local: stage: typecheck

fn apply(f: fn() -> int) -> int {
  f()
}

fn twice(x: int, f: fn(int) -> int) -> int {
  f(x) + f(x)
}

// the trailing block argument is sugar that lowers in its own round; the
// parenthesized spellings below (the capturing one included) run
fn call_with_block() -> int {
  apply { 42 }
}

fn call_with_lambda() -> int {
  apply(() => 42)
}

fn call_one_arg() -> int {
  twice(21, (x: int) => x * 2)
}

fn call_stored() -> int {
  const g = () => 42
  g()
}

fn call_passed() -> int {
  const g = () => 42
  apply(g)
}

// the capture itself runs when spelled parenthesized; the block spelling
// waits with call_with_block
fn capture_over_local() -> int {
  const base = 7
  apply { base + 1 }
}
