// source: F2 "functions are values" and F7's trailing lambda, against the b07 callable-word seam audit 2026-11-10
// purpose: lambda values in every argument shape run through the callable words (fn-typed parameters, let-stored and passed lambdas, a capturing closure, and the trailing block staging like the written lambda)
// items:
// apply: stage: run
// twice: stage: run
// call_with_block: stage: run
// call_with_lambda: stage: run
// call_one_arg: stage: run
// call_stored: stage: run
// call_passed: stage: run
// capture_over_local: stage: run
// mutates-its-captured-var: stage: run

fn apply(f: fn() -> int) -> int {
  f()
}

fn twice(x: int, f: fn(int) -> int) -> int {
  f(x) + f(x)
}

// the trailing block argument stages exactly like the written trailing
// lambda (the sugar's byte-identical contract)
fn call_with_block() -> int {
  apply { 42 }
}

fn call_with_lambda() -> int {
  apply(() => 42)
}

fn call_one_arg() -> int {
  twice(21, (x: int) => x * 2)
}

fn call_stored() -> int {
  const g = () => 42
  g()
}

fn call_passed() -> int {
  const g = () => 42
  apply(g)
}

// the capturing block stages its closure word like the parenthesized
// spelling's
fn capture_over_local() -> int {
  const base = 7
  apply { base + 1 }
}

// the affine closure (the 2026-11-25 ruling): a lambda capturing a var
// binding moves it, the closure mutating its own captured state through
// the mut window over the uniquely-held capture block
fn mutates_its_captured_var() -> int {
  var counter: int = 0
  const cell = (op: int) => {
    if op == 1 {
      counter = counter + 1
    }
    counter
  }
  cell(1)
  cell(1)
  cell(0)
}
