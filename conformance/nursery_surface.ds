// source: M5, the nursery/spawn surface round
// purpose: the in-language nursery surface: spawn-in-scope, join at scope exit in spawn order collecting the children's answers into the block's list, first-failure cancellation at safe points, child error unioning out at the boundary, a completing child's deinit claim, and the payloaded cancel shapes (a struct member's flat span and a generic application's one Ref word)
// items:
// seam_fail: stage: run
// claimed: stage: run
// guarded: stage: run
// guarded_cancel: stage: run
// mixed: stage: run
// guarded_claim: stage: run
// payloaded: stage: run
// captured: stage: run
// main: stage: run

struct seam_fail { code: int, detail: string }

struct claimed: ~Copyable {
  id: int
  deinit { println("freed ${self.id}") }
}

fn guarded(n: int) -> int | net_err {
  const xs = nursery {
    for i in 0..n {
      spawn { i }
    }
  }
  const kept = xs.len()
  kept
}

fn guarded_cancel(n: int) -> int | net_err {
  nursery {
    spawn {
      cancel(net_err::timeout)
    }
    spawn {
      var i = 0
      while i < n {
        i = i + 1
      }
      i
    }
  }
  0
}

fn mixed(n: int) -> int | net_err {
  nursery {
    spawn { 7 }
    spawn {
      cancel(refused)
    }
    spawn {
      var i = 0
      while i < n {
        i = i + 1
      }
      i
    }
  }
  0
}

fn guarded_claim() -> int | net_err {
  nursery {
    spawn {
      const c = claimed { id: 1 }
      println("ran ${c.id}")
    }
  }
  0
}

// a struct member cancels: the child stages the member's flat word span
// behind its tag, the boundary delivers it, and the caller's catch arm
// reads the fields
fn payloaded(n: int) -> seam_fail | none {
  nursery {
    spawn {
      cancel(seam_fail { code: n, detail: "payload" })
    }
  }
  none
}

// a list member cancels: the generic application claims one Ref word, and
// the caller reads the captured list through its natives
fn captured(n: int) -> list[int] | net_err {
  const xs = [1, 2, n]
  nursery {
    spawn {
      cancel(xs)
    }
  }
  list[int]()
}

fn main() -> () {
  match guarded(3) {
    timeout => println("t")
    refused => println("r")
    addr_in_use => println("a")
    reset => println("x")
    net_other { msg } => println("o")
    n => println("guarded kept ${n}")
  }
  match guarded_cancel(500000) {
    timeout => println("t")
    refused => println("r")
    addr_in_use => println("a")
    reset => println("x")
    net_other { msg } => println("o")
    n => println("cancel kept ${n}")
  }
  match mixed(500000) {
    timeout => println("t")
    refused => println("r")
    addr_in_use => println("a")
    reset => println("x")
    net_other { msg } => println("o")
    n => println("mixed kept ${n}")
  }
  match guarded_claim() {
    timeout => println("t")
    refused => println("r")
    addr_in_use => println("a")
    reset => println("x")
    net_other { msg } => println("o")
    n => println("claim kept ${n}")
  }
  match payloaded(3) {
    none => println("clean")
    f => println("code ${f.code} ${f.detail}")
  }
  match captured(3) {
    timeout => println("t")
    refused => println("r")
    addr_in_use => println("a")
    reset => println("x")
    net_other { msg } => println("o")
    xs => println("list ${xs.len()}")
  }
}
