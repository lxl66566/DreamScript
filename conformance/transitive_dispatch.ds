// source: the transitive evidence round 2026-11-12 (H3)
// purpose: the two-level generic-impl dispatch chain — a generic tells impl for list[t] dispatching through the list's own generic shows impl, the entering concrete site staging the serving body's whole evidence area — entered at int and string, one nested-list hop, two levels max
// items:
// shows: stage: typecheck
// tells: stage: typecheck
// shows-int: stage: run
// shows-string: stage: run
// shows-list: stage: run
// tells-list: stage: run
// main: stage: run

trait shows {
  fn show(self) -> string
}

trait tells {
  fn tell(self) -> string
}

impl shows for int {
  fn show(self) -> string { "n=$self" }
}

impl shows for string {
  fn show(self) -> string { "$self!" }
}

impl[t: shows] shows for list[t] {
  fn show(self) -> string {
    var acc = "["
    for x in self {
      acc = "${acc}${x.show()},"
    }
    acc + "]"
  }
}

impl[t: shows] tells for list[t] {
  fn tell(self) -> string { "got ${self.show()}" }
}

fn main() -> () {
  println("${[6, 7].tell()}")
  println("${["x", "y"].tell()}")
  println("${[[5]].tell()}")
}
