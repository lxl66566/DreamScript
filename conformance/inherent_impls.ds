// source: F3 method tier — the inherent-impl checker surface (the R26 live signature table, owner-typed) plus its dispatch landing
// purpose: inherent impls dot-call through the owner-typed method table (two owners share one name, wrong receivers report at the dot); the member bodies plan under the `<target>#<member>` mangle and the call sites dispatch as plain local calls
// items:
// counter: stage: typecheck
// timer: stage: typecheck
// impl-counter: stage: run
// impl-timer: stage: run
// use-both: stage: run
// use-fields: stage: run
// wrong-receiver: stage: reject DS2013 no method `peek` accepts receiver `int`

struct counter { ticks: int }
struct timer { laps: int }
impl counter { fn peek(self) -> int { 1 } }
impl timer { fn peek(self) -> int { 2 } }

// the two owners share the method name; each dot-call selects its own
// owner's signature [F3]
fn use_both(c: counter, t: timer) -> int {
  c.peek() + t.peek()
}

// the receiver binds Self: field access through it checks
fn use_fields(c: counter) -> int {
  c.peek() + c.ticks
}

fn wrong_receiver(x: int) -> int {
  x.peek()
}
