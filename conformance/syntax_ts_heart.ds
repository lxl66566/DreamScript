// source: frozen archive catalog 04-syntax (seed corpus)
// purpose: the full surface program: guards, bare return, ?, .err, interpolation, destructuring, tuple match; the row reads wait on the generic `get` callee's M6 dispatch seam
// items:
// parse_error: stage: typecheck
// user: stage: typecheck
// sep: stage: typecheck
// get: stage: typecheck
// load_rows: stage: typecheck
// read_config: stage: typecheck
// default_config: stage: typecheck
// parse_age: stage: run
// parse_user: stage: typecheck
// main: stage: run

enum parse_error { bad_number(string), missing_field(string) }

struct user {
  name: string
  age: int
}

// F6 byte literal: `b'x'` is pinned to the ambient's `tag byte` atom, so
// the item types with no user declaration
const sep = b'\n'

// the row reads' seams, file-owned since the ambient shed its dead
// declarations (no native answers these callees; the uses keep their
// staged spellings and refuse at lowering as the header records)
extern fn get[k, v](m: map[k, v], key: k) -> v | none
extern fn load_rows(path: string) -> list[row] | io_err
extern fn read_config(path: string) -> config | io_err
extern fn default_config() -> config

fn parse_age(s: string) -> int | parse_error {
  match s.trim().parse_int() {
    parse_err => bad_number(s)
    n => n
  }
}

// the row reads ride the ambient `get` extern, whose generic dispatch is
// the M6 CALL_GENERIC seam maps_surface's get_spelling records; the
// narrowing and `?` shapes around them check clean
fn parse_user(row: row) -> user | parse_error {
  const name = row.get("name")
  if name is none { return missing_field("name") }
  const age = row.get("age")
  if age is none { return missing_field("age") }
  user { name, age: parse_age(age)? }
}

fn main() -> () | io_err {
  const rows = load_rows("users.csv")?
  const cfg = read_config("app.cfg").err((e) => {
    println("config failed: ${str(e)}")
    default_config()
  })
  const (users, errors) = rows.map(parse_user).partition((r) => r is parse_error)

  const total = users
    .filter((u) => u.age >= 18)
    .map((u) => u.age * 2)
    .reduce(0, (a, b) => a + b)

  for u in users {
    println("user ${u.name} age ${u.age}")
  }

  match (total, errors.first()) {
    (_, e) if e is parse_error => println("warning: ${str(e)}")
    (0, _) => println("no valid users")
    (t, _) => println("total score: ${t}")
  }
}
