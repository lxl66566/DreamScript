// source: the record's declaration/construction story (B3, F7) and F9's type-namespace constructor resolution, adopted 2026-11-10
// purpose: list literals and the list[t]() empty constructor against the checked list surface
// items:
// page: stage: typecheck
// sum_ints: stage: run
// words_report: stage: run
// empty_pages: stage: run
// fresh_ints: stage: run
// seeds_total: stage: run
// for_sum: stage: run
// member_scan: stage: run
// csv_line: stage: run
// cons_records: stage: run (the stride-aware copy closes, heap-list slice 2026-11-12)
// record_iteration: stage: run (for-in and membership over wider elements, heap-list slice 2026-11-12)
// reject-mixed: stage: reject the mixed-element literal names the offending item's type (DS2001) [B3]

struct page { url: string }

fn sum_ints() -> int {
  const xs = [1, 2, 3]
  var total: int = 0
  var i: int = 0
  while i < xs.len() {
    const cell = xs.get(i)
    total += cell.ok((x: int) => x).err((_: none) => 0)
    i += 1
  }
  total
}

fn words_report() -> string {
  const words = ["alpha", "beta", "gamma"]
  const joined = words.concat(["delta"])
  const first = joined.get(0)
  first.ok((w: string) => w).err((_: none) => "?")
}

fn empty_pages() -> int {
  const pages = list[page]()
  const n = pages.len()
  n
}

fn fresh_ints() -> list[int] {
  []
}

fn seeds_total() -> int {
  const seeds: list[int] = [10, 20]
  seeds.len() + fresh_ints().len()
}

fn for_sum() -> int {
  const xs = [1, 2, 3]
  var total: int = 0
  for x in xs {
    total += x
  }
  total
}

fn member_scan() -> bool {
  const words = ["alpha", "beta"]
  2 in [1, 2, 3] && "beta" in words && !("delta" in words)
}

// join renders the parts list back to one string, the separator between
// neighbors; the empty list answers the empty string
fn csv_line() -> string {
  const words = ["alpha", "beta", "gamma"]
  const csv = words.join(',')
  const blank = list[string]().join(',')
  csv + "|" + blank
}

// the copy closes carry whole record spans at the per-list stride: the
// cons head stages its span, the first prepend fixes the empty list's
// stride, and tail/collect/concat keep the source's
fn cons_records() -> int {
  const empty = list[page]()
  const one = cons(page { url: "a" }, empty)
  const two = cons(page { url: "b" }, one)
  const joined = two.concat(collect(two))
  const rest = tail(two)
  joined.len() * 10 + rest.len()
}

// iteration and membership bind the whole element span per step
fn record_iteration() -> int {
  var total = 0
  const pages = [page { url: "a" }, page { url: "b" }]
  for p in pages {
    if p.url == "b" { total += 1 }
  }
  const hit = page { url: "a" } in pages
  const miss = page { url: "z" } in pages
  if hit { total += 10 }
  if miss { total += 100 }
  total
}

fn reject_mixed() -> int {
  const bad = [1, "a"]
  0
}
