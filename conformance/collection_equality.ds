// source: the list and map structural equality round 2026-11-18 (todo item 5's collection-equality slice, B9), the bit-structural float judge round 2026-11-21 (the 2026-11-21 ruling closing review B10)
// purpose: structural ==/!= over the collections' one Ref word dispatch the content-compare natives — nested collections compose (a list of lists, a map over list values, a struct field of list and map type), and in membership compares the element by its type (a list element over a list of lists, a struct element whose fields are collections); the float judge is the one bit-structural word equality everywhere (scalar ==, in, collection content equality, and map key matching: a NaN is reflexive, the two zeros distinct), and the spelled refusal (a union element without content equality) lives in collection_equality_refusal.ds
// items:
// holds: stage: run
// nested-rows: stage: run
// matrix-rows: stage: run
// field-rows: stage: run
// member-rows: stage: run
// float-rows: stage: run
// main: stage: run

struct holds { tags: list[string], table: map[string, int] }

fn nested_rows() -> bool {
  const one = [[1, 2], [3]]
  const two = [[1, 2], [3]]
  const diff = [[1, 2], [4]]
  one == two && one != diff
}

fn matrix_rows() -> bool {
  var one = map[string, list[int]]()
  one.set("k", [1, 2])
  var two = map[string, list[int]]()
  two.set("k", [1, 2])
  var diff = map[string, list[int]]()
  diff.set("k", [1, 3])
  one == two && one != diff
}

fn field_rows() -> bool {
  var t1 = map[string, int]()
  t1.set("k", 1)
  var t2 = map[string, int]()
  t2.set("k", 1)
  var t3 = map[string, int]()
  t3.set("k", 2)
  const one = holds { tags: ["a", "b"], table: t1 }
  const two = holds { tags: ["a", "b"], table: t2 }
  const short = holds { tags: ["a"], table: t1 }
  const swapped = holds { tags: ["a", "b"], table: t3 }
  one == two && one != short && one != swapped
}

fn member_rows() -> bool {
  var t1 = map[string, int]()
  t1.set("k", 1)
  var t2 = map[string, int]()
  t2.set("k", 1)
  const xs = [["a"], ["b"]]
  const group = [holds { tags: ["x"], table: t1 }, holds { tags: [], table: t2 }]
  ["a"] in xs && !(["c"] in xs) && holds { tags: ["x"], table: t1 } in group && !(holds { tags: ["q"], table: t1 } in group)
}

// the one bit-structural judge over floats: scalar == and in, collection
// content equality, and map key matching all answer the same — a NaN
// equals itself (reflexive), the two zeros differ, a NaN key overwrites
// its own row, and the two zeros hold two distinct findable rows
fn float_rows() -> bool {
  const n = 0.0 / 0.0
  const z = 0.0
  const nz = parse_float("-0").ok((v: float) => v).err((_: parse_err) => 0.0)
  const scalar = n == n && !(z == nz)
  const lists = [n] == [n] && !([z] == [nz])
  const member = n in [n] && !(nz in [z])
  var nans = map[float, int]()
  nans.set(n, 1)
  nans.set(n, 2)
  const nan_rows = map_len(nans) == 1 && match nans.get(n) {
    none => false
    v => v == 2
  }
  var zeros = map[float, int]()
  zeros.set(z, 1)
  zeros.set(nz, 2)
  const zero_rows = map_len(zeros) == 2 && match zeros.get(z) {
    none => false
    v => v == 1
  } && match zeros.get(nz) {
    none => false
    v => v == 2
  }
  scalar && lists && member && nan_rows && zero_rows
}

fn main() -> () {
  println("nested ${nested_rows()}")
  println("matrix ${matrix_rows()}")
  println("fields ${field_rows()}")
  println("member ${member_rows()}")
  println("float ${float_rows()}")
}
