// source: frozen archive catalog 05-generics-metaprogramming (seed corpus)
// purpose: ~Copyable generic stack, disjoint instance heads plus rejection, derive + comptime schema, evidence dispatch
// items:
// stack: stage: typecheck
// push: stage: typecheck
// pop: stage: typecheck
// json-text: stage: typecheck
// impl-json-text-int: stage: typecheck
// impl-json-text-bool: stage: typecheck
// impl-json-text-list: stage: typecheck
// impl-json-text-int-bool: stage: reject instance head int | bool intersects the int and bool heads; witness int [B6]
// point: stage: m6
// schema: stage: m6
// p1: stage: m6
// p2: stage: m6
// p: stage: m6
// js: stage: m6

// 1. polymorphic container API over affine elements [C1, D2]
struct stack[t] { items: list[t] }
fn push[t: ~Copyable](s: stack[t], x: t) -> stack[t] {
  stack { items: cons(x, s.items) }
}
fn pop[t: ~Copyable](s: stack[t]) -> (stack[t], t?) {
  (stack { items: s.items.tail() }, s.items.first())
}

// 2. traits with disjoint instance heads [B6]
trait json_text {
  fn spell(self) -> string
}
impl json_text for int {
  fn spell(self) -> string { str(self) }
}
impl json_text for bool {
  fn spell(self) -> string { str(self) }
}
impl[t: json_text] json_text for list[t] {
  fn spell(self) -> string { "[" + self.map((x) => x.spell()).join(',') + "]" }
}
impl json_text for int | bool {
  fn spell(self) -> string { str(self) }
}

// 3. derive + comptime reflection [G1, G2]
#[derive(hash, show, to_json, ord)]
struct point { x: int, y: int }
fn schema(comptime t: type) -> string {
  var s = "{"
  for f in fields(t) {
    s += f.name + ": " + type_name(f.type) + ", "
  }
  s + "}"
}

// 4. execution: one body per generic fn + evidence words [H3]
const p1 = point { x: 1, y: 2 }
const p2 = point { x: 3, y: 4 }
const p = max(p1, p2)
const js = p.to_json()
