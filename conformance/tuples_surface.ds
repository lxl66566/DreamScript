// source: record B3 anonymous tuples, the expected-gap round closing tuple lowering
// purpose: tuple construction, destructuring in bindings and match arms, one-word elements on the frame
// items:
// pair_of: stage: run
// swap: stage: run
// arm_sum: stage: run
// one_word: stage: run
// unit_word: stage: run
// list_bearing: stage: run
// unit_box: stage: typecheck
// unit_word: stage: typecheck
// unit_alias: stage: typecheck
// reject-union-destructure: stage: reject a destructuring declaration over a union binds unproven members (DS2001) [B3, F4]

fn pair_of(host: string, port: int) -> (string, int) {
  const t = (host, port)
  const (name, n) = t
  (name, n)
}

fn swap(a: int, b: string) -> (string, int) {
  const (s, n) = (b, a)
  (s, n)
}

fn arm_sum(t: (int, int)) -> int {
  match t {
    (a, b) => a + b
  }
}

fn one_word() -> int {
  const one = (5,)
  const (five,) = one
  five
}

fn unit_word() -> () {
  const z: () = ()
  z
}

fn list_bearing() -> int {
  const l = ([1, 2], "two")
  const (xs, s) = l
  const n = xs.len()
  n
}

// the ()-typed field checks clean at the declaration while the empty
// tuple stays outside the inline-span vocabulary: the bare () is the
// frame's one canonical unit word, so a field over it would span zero
// words — the written tuple and the aliased tuple atom alike refuse at
// the lowering door (the 2026-11-24 empty-tuple field round; the
// refusal is pinned in the ds-lower tuples_e2e suite)
struct unit_box { u: () }

type unit_word = ()

struct unit_alias { u: unit_word }

fn reject_union_destructure(u: (int, int) | none) -> int {
  const (a, b) = u
  a
}
