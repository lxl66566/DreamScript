import @std/io (println)
import @shapes (defaulted)

impl defaulted for float {}

fn weigh(s: string) -> int {
  s.answer()
}

fn main() -> int {
  const once = 3.answer()
  const own = 2.5.answer()
  const x = "x"
  println("${once + own + weigh(x)}")
  0
}
