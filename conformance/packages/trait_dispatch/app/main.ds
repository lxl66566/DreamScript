import @std/io (println)
import @shapes (pair, cell, shapey, make)

fn weigh(p: pair) -> int {
  p.size()
}

fn main() -> int {
  const made = pair { a: 30, b: 12 }
  const once = made.size()
  const c = make(4)
  println("${once + weigh(made) + c.size()}")
  0
}
