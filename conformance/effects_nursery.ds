// source: frozen archive catalog 03-effects-errors-async (seed corpus)
// purpose: nursery fetch_all with cancel-on-failure, union errors, retry loop, par combinators; the nursery and retry shapes lower (nursery_surface.ds and the gate's probes prove them), the fetch-driven items check clean and wait on their non-nursery seams
// items:
// url: stage: typecheck
// page: stage: typecheck
// fetch_body: stage: typecheck
// fetch_all: stage: typecheck
// with_retry: stage: typecheck
// main: stage: typecheck
// v2-handler: stage: unresolved: user-defined handlers are a v2 additive escape hatch [E1], not parsed in v1

type url = string
struct page { url: url, body: string }

// the fetch extern has no builtin seam (consume is the same shape of
// callee), so the body refuses at lowering though it checks clean
fn fetch_body(url: url) -> page | net_err {
  const resp = fetch(url)?
  page { url: url, body: resp.consume() }
}

// the union shapes lower (the list member is a heap-ref application
// word); the fetch extern seam keeps the item at typecheck
fn fetch_all(urls: list[url]) -> list[page] | net_err {
  var pages = list[page]()
  nursery {
    for url in urls {
      spawn {
        match fetch_body(url) {
          timeout => cancel(timeout)
          refused => cancel(refused)
          p => pages.list_push(p)
        }
      }
    }
  }
  pages
}

// the retry loop's shapes (for over a range, the leading-binding arm,
// break) lower and run; only the fetch callee waits
fn with_retry(n: int, url: url) -> page | net_err {
  var last: net_err = timeout
  var done: page? = none
  for i in 0..n {
    match fetch_body(url) {
      timeout => {
        last = timeout
      }
      refused => {
        last = refused
      }
      p => {
        done = p
        break
      }
    }
  }
  match done {
    none => last
    p => p
  }
}

// main adds the ambient urls const (top-level values do not lower yet)
// and the par_map/par_reduce combinators, both without natives
fn main() -> () | net_err {
  const pages = fetch_all(urls).err((e: net_err) => die("all fetches failed"))
  print("total: ${str(pages.par_map((p) => p.body.len()).par_reduce(0, (a, b) => a + b))}")
}

// v2, additive with no migration, user handlers for final/tail-resumptive effects only [E1]:
// with handler { op ask() => resume(42) }
